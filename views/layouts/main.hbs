<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/public/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/public/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/public/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/public/favicon-64.png" />
    <link rel="icon" type="image/png" sizes="128x128" href="/public/favicon-128.png" />
    <link rel="apple-touch-icon" sizes="256x256" href="/public/favicon-256.png" />
    <link rel="shortcut icon" href="/public/favicon.ico" />
    <link rel="manifest" href="/public/manifest.webmanifest" />
    <link rel="stylesheet" href="/public/css/styles.css?v=4.6-print-engine" />
  </head>
  <body data-ag-current-user="{{currentUsername}}" data-ag-current-role="{{currentRoleCode}}" data-ag-current-location="{{currentLocationCode}}">
    <div class="erp-desktop-shell">
      <header class="erp-titlebar">
        <div class="brand-zone">
          <img class="brand-road" src="/public/assets/brand/autogrand-road-icon.png" alt="AutoGrand" />
          <div class="brand-company">{{companyName}}</div>
          <div class="brand-version">{{appVersion}}</div>
        </div>

        <div class="titlebar-user">
          <div class="titlebar-context" title="{{sessionLabel}}">
            <strong>{{userName}}</strong>
            <span class="titlebar-role">{{currentRoleName}}</span>
            <em class="titlebar-location-name">{{currentLocationName}}</em>
            <small class="titlebar-permission-scope">{{activePermissionScopeLabel}}</small>
          </div>
          <span class="top-icon">💬</span>
          <span class="top-icon">▶</span>
          <span class="top-icon badge">🌐<em>2</em></span>
          <span class="top-icon badge">🔔<em>6</em></span>
          <span class="top-icon">⚙</span>
          <span class="top-icon">🖌</span>
          <span class="top-icon">👤</span>
          <form class="logout-form" method="post" action="/logout">
            <button class="logout-button" type="submit">Изход</button>
          </form>
        </div>
      </header>

      <section class="erp-ribbon" aria-label="Командна ERP лента">
        {{#each ribbonGroups}}
          <div class="ribbon-group" data-ribbon-group="{{id}}">
            <div class="ribbon-buttons">
              {{#each buttons}}
                <button class="ribbon-button" type="button" data-ribbon-command="{{command}}" title="{{hint}}" aria-label="{{label}}">
                  <span class="ribbon-icon" aria-hidden="true">{{icon}}</span>
                  <span class="ribbon-label">{{label}}</span>
                </button>
              {{/each}}
            </div>
            <div class="ribbon-group-title">{{title}}</div>
          </div>
        {{/each}}
      </section>

      <div class="erp-main">
        {{> sidebar}}

        <main class="erp-workspace" id="ag-v2-workspace">
          <div class="tab-strip" id="ag-v2-workspace-tabs">
            <button type="button" class="workspace-tab is-active" data-workspace-home>Начало</button>
          </div>

          <section class="workspace-stage" id="ag-v2-workspace-stage">
            <section class="workspace-window workspace-home-window is-active" id="ag-v2-workspace-home" data-window-title="{{title}}">
              {{{body}}}
            </section>
            <div class="ag-v2-window-layer" id="ag-v2-window-layer" aria-live="polite"></div>
            <div class="ag-v2-minimized-dock" id="ag-v2-minimized-dock" aria-label="Минимизирани прозорци"></div>
          </section>
        </main>
      </div>

      <footer class="erp-statusbar" aria-label="ERP статус лента">
        <div class="statusbar-cell statusbar-message" data-ag-status-message>
          <span class="statusbar-icon statusbar-icon-menu" aria-hidden="true">☰</span>
          <span class="statusbar-text" data-ag-status-text>{{statusText}}</span>
        </div>
        <div class="statusbar-cell statusbar-mode">
          <span class="statusbar-icon" aria-hidden="true">🖥️</span>
          <span class="statusbar-text">Работна среда</span>
        </div>
        <div class="statusbar-cell statusbar-location">
          <span class="statusbar-icon" aria-hidden="true">📍</span>
          <span class="statusbar-text">{{currentLocationName}}</span>
        </div>
        <div class="statusbar-cell statusbar-user">
          <span class="statusbar-icon" aria-hidden="true">👤</span>
          <span class="statusbar-text">{{userRoleLabel}}</span>
        </div>
        <div class="statusbar-cell statusbar-app">
          <span class="statusbar-icon" aria-hidden="true">🧩</span>
          <span class="statusbar-text">AutoGrand ERP</span>
        </div>
        <div class="statusbar-cell statusbar-db">
          <span class="statusbar-icon" aria-hidden="true">🗄️</span>
          <span class="statusbar-text">{{databaseName}}</span>
        </div>
        <div class="statusbar-cell statusbar-date">
          <span class="statusbar-icon" aria-hidden="true">🕒</span>
          <span class="statusbar-text" data-ag-status-clock>{{statusDateTime}}</span>
        </div>
      </footer>
    </div>

    <script src="/public/js/app.js?v=4.6-print-engine"></script>
    <script src="/public/js/ag-grid-column-preferences.js?v=4.6-print-engine"></script>
    <script src="/public/js/ag-document-engine.js?v=4.6-print-engine"></script>
    <script src="/public/js/ag-print-engine.js?v=4.6-print-engine"></script>
    <script src="/public/js/erp-v2-workspace-manager.js?v=4.6-print-engine"></script>
  
<!-- AutoGrand ERP V2 Step 4.8.4 legacy checker markers -->
<!-- STEP_4_4_CACHE_VERSION_SYNC -->
<!-- STEP_4_4_LAYOUT_INTEGRATION_AND_CACHE_VERSION -->
