<section class="ag-step-412 ag-step-4121 ag-step-4122 ag-step-4123 module-page" data-module="inventory-planning-supplier-detail" data-step="4.12.3">
  <header class="module-hero ag-step-412__hero ag-step-4123__supplier-hero">
    <div>
      <p class="module-kicker">Supplier purchase detail · Само анализ</p>
      <h1>{{supplierDetail.supplier.supplierName}}</h1>
      <p class="module-lead">
        Детайлен purchase planning изглед за доставчик: препоръчани редове, складове, групи и ръчни управленски стъпки.
      </p>
      <div class="ag-step-4121__hero-meta">
        <span>Snapshot: {{supplierDetail.step}}</span>
        <span>Източник: {{supplierDetail.sourceName}}</span>
        <span>API: {{supplierDetail.apiHref}}</span>
      </div>
    </div>
    <div class="ag-step-412__guard-card ag-step-4123__supplier-guard">
      <strong>Без автоматична покупка</strong>
      <span>Този екран не създава purchase, transfer или correction документ.</span>
      <a class="ag-step-4122__back" href="{{supplierDetail.backHref}}">← Назад към доставчици</a>
    </div>
  </header>

  <section class="ag-step-412__summary-grid ag-step-4121__summary-grid ag-step-4123__supplier-kpis" aria-label="Supplier detail KPI cards">
    <article class="ag-step-412__metric ag-step-4121__metric is-warning">
      <span>Редове за покупка</span>
      <strong>{{supplierDetail.supplier.reorderLineCount}}</strong>
      <small>{{supplierDetail.supplier.display.recommendedOrderQtyTotal}} предложено количество</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric is-danger">
      <span>Критични</span>
      <strong>{{supplierDetail.supplier.criticalCount}}</strong>
      <small>артикули с риск</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric is-money">
      <span>Стойност</span>
      <strong>{{supplierDetail.supplier.display.recommendedOrderValueTotal}}</strong>
      <small>ориентировъчна purchase стойност</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric">
      <span>Обхват</span>
      <strong>{{supplierDetail.supplier.itemCount}}</strong>
      <small>артикули в supplier snapshot</small>
    </article>
  </section>

  <section class="ag-step-4122__detail-grid">
    <article class="module-card ag-step-412__card ag-step-4123__supplier-manual-card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Manual purchase decision</p>
          <h2>{{supplierDetail.supplier.manualActionLabel}}</h2>
        </div>
        <span class="ag-step-4123__supplier-priority tone-{{supplierDetail.supplier.priority}}">{{supplierDetail.supplier.priorityLabel}}</span>
      </div>
      <ul class="ag-step-4122__check-list">
        {{#each supplierDetail.manualSteps}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
      <div class="ag-step-4122__readonly-lock">
        <strong>Read-only</strong>
        <span>Покупка се създава само ръчно в purchase модула след човешко решение.</span>
      </div>
    </article>

    <article class="module-card ag-step-412__card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Supplier facts</p>
          <h2>Обхват</h2>
        </div>
      </div>
      <dl class="ag-step-4122__facts">
        <dt>Складове</dt><dd>{{supplierDetail.supplier.warehouseList}}</dd>
        <dt>Групи</dt><dd>{{supplierDetail.supplier.groupList}}</dd>
        <dt>Бавно движение</dt><dd>{{supplierDetail.supplier.slowMovingCount}}</dd>
        <dt>Наблюдение</dt><dd>{{supplierDetail.supplier.watchCount}}</dd>
        <dt>Stock value</dt><dd>{{supplierDetail.supplier.display.stockValueTotal}}</dd>
      </dl>
    </article>
  </section>

  <section class="module-card ag-step-412__card ag-step-4123__supplier-table-card">
    <div class="module-card-header">
      <div>
        <p class="module-kicker">Purchase recommendation lines</p>
        <h2>Препоръчани редове за преглед</h2>
      </div>
      <span class="ag-step-412__readonly-badge">manual only</span>
    </div>
    <div class="ag-step-412__table-wrap">
      <table class="ag-step-412__table ag-step-4123__supplier-table">
        <thead>
          <tr>
            <th>Артикул</th>
            <th>Склад</th>
            <th>Група</th>
            <th>Риск</th>
            <th class="num">Проектна</th>
            <th class="num">Мин.</th>
            <th class="num">Предл.</th>
            <th class="num">Стойност</th>
            <th>Детайл</th>
          </tr>
        </thead>
        <tbody>
          {{#each supplierDetail.purchaseLines}}
            <tr>
              <td><strong>{{itemCode}}</strong><small>{{itemName}}</small></td>
              <td>{{warehouseName}}</td>
              <td>{{groupName}}</td>
              <td>{{riskLabel}}</td>
              <td class="num">{{displayProjectedQty}}</td>
              <td class="num">{{displayMinimumQty}}</td>
              <td class="num"><strong>{{displayRecommendedOrderQty}}</strong></td>
              <td class="num">{{displayRecommendedOrderValue}}</td>
              <td><a class="ag-step-4122__detail-link" href="{{detailHref}}">Артикул</a></td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ag-step-4121__breakdowns">
    <article class="module-card ag-step-412__card ag-step-4121__breakdown-card">
      <div class="module-card-header"><div><p class="module-kicker">Warehouse split</p><h2>По складове</h2></div></div>
      <ul class="ag-step-4121__breakdown-list">
        {{#each supplierDetail.warehouseBreakdown}}
          <li><strong>{{warehouseName}}</strong><span>предл. {{display.recommendedOrderQty}} · риск {{riskLabel}}</span><small>stock value {{display.stockValue}}</small></li>
        {{/each}}
      </ul>
    </article>

    <article class="module-card ag-step-412__card ag-step-4121__breakdown-card">
      <div class="module-card-header"><div><p class="module-kicker">Group split</p><h2>По групи</h2></div></div>
      <ul class="ag-step-4121__breakdown-list">
        {{#each supplierDetail.groupBreakdown}}
          <li><strong>{{title}}</strong><span>{{itemCount}} артикула · дозареждане {{reorderCount}}</span><small>стойност {{displayRecommendedOrderValue}}</small></li>
        {{/each}}
      </ul>
    </article>
  </section>

  <footer class="ag-step-412__footer-note ag-step-4121__footer-note ag-step-4123__footer-note">
    <strong>Guardrails:</strong>
    {{#each supplierDetail.guardrails}}
      <span>{{this}}</span>
    {{/each}}
  </footer>
</section>
