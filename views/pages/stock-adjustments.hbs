<!-- Step 4.8.2 compatibility marker: data-ag-step="4.8.2" -->
<!-- Step 4.8.3 compatibility marker: data-ag-step="4.8.3" -->
<section class="ag-stock-adjustments-page" data-ag-step="4.8.4">
  <div class="ag-page-header ag-stock-adjustments-hero">
    <div>
      <div class="ag-kicker">AutoGrand ERP V2 · Step 4.8.4</div>
      <h1>Складови корекции</h1>
      <p>
        Постоянни документи за складова корекция: DRAFT → POSTED, заключване след POSTED, movement trace, audit trail и безопасна обратна корекция.
      </p>
    </div>
    <div class="ag-step-badge">Audit safety</div>
  </div>

  <div class="ag-moneta-rules">
    <strong>Правило:</strong>
    не трием стари движения, не редактираме журнала ръчно, коригираме само чрез отделен документ, записваме audit trail и при грешка правим нов обратен DRAFT документ.
  </div>

  <section class="ag-card ag-binding-card" id="agMovementBindingCard">
    <div class="ag-card-title-row">
      <div>
        <h2>Stock movement binding</h2>
        <p>POSTED корекцията използва реалния слой за складови движения. Ако binding липсва, POST се отказва безопасно.</p>
      </div>
      <button type="button" class="ag-btn ag-btn-secondary" id="agReloadBindingBtn">Провери binding</button>
    </div>
    <div id="agBindingStatus" class="ag-binding-status"></div>
  </section>

  <div class="ag-stock-adjustments-grid">
    <section class="ag-card ag-card-list">
      <div class="ag-card-title-row">
        <div>
          <h2>Документи</h2>
          <p>DRAFT документи могат да се редактират. POSTED документи са заключени и показват movement trace, audit trail и безопасна reversal опция.</p>
        </div>
        <button type="button" class="ag-btn ag-btn-secondary" id="agReloadAdjustmentsBtn">Обнови</button>
      </div>
      <div id="agAdjustmentList" class="ag-adjustment-list"></div>
    </section>

    <section class="ag-card ag-card-editor">
      <h2>Нов документ</h2>
      <form id="agCreateAdjustmentForm" class="ag-form-stack">
        <label>
          Основание
          <input name="reason" type="text" value="Складова корекция" autocomplete="off" />
        </label>
        <label>
          Бележка
          <textarea name="note" rows="3" placeholder="Напр. корекция след ревизия, отрицателна наличност или двойно движение"></textarea>
        </label>
        <button type="submit" class="ag-btn ag-btn-primary">Създай DRAFT</button>
      </form>

      <div id="agAdjustmentDetails" class="ag-adjustment-details is-empty">
        <div class="ag-empty-state">Избери или създай документ, за да добавиш редове.</div>
      </div>
    </section>
  </div>
</section>

<script>
(function () {
  const initialDocuments = {{{initialDocumentsJson}}};
  const initialBinding = {{{initialBindingJson}}};
  let documents = Array.isArray(initialDocuments) ? initialDocuments : [];
  let movementBinding = initialBinding || null;
  let activeDocument = null;

  const listEl = document.getElementById("agAdjustmentList");
  const detailsEl = document.getElementById("agAdjustmentDetails");
  const bindingEl = document.getElementById("agBindingStatus");
  const reloadBtn = document.getElementById("agReloadAdjustmentsBtn");
  const reloadBindingBtn = document.getElementById("agReloadBindingBtn");
  const createForm = document.getElementById("agCreateAdjustmentForm");

  function formatNumber(value) {
    const n = Number(value || 0);
    return new Intl.NumberFormat("bg-BG", { maximumFractionDigits: 3 }).format(n);
  }

  function statusLabel(status) {
    return status === "POSTED" ? "POSTED · заключен" : "DRAFT";
  }

  function escapeHtml(value) {
    return String(value || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  async function api(path, options) {
    const response = await fetch(path, {
      headers: { "Content-Type": "application/json" },
      ...(options || {})
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok || payload.ok === false) {
      throw new Error(payload.error || "Грешка при складова корекция.");
    }
    return payload;
  }

  function renderBinding() {
    const active = movementBinding && movementBinding.active;
    const candidates = movementBinding && Array.isArray(movementBinding.candidates) ? movementBinding.candidates : [];
    const statusClass = active ? "is-bound" : "is-missing";
    const statusText = active ? "BOUND" : "НЕ Е НАМЕРЕН BINDING";
    const detail = active
      ? `Таблица: ${escapeHtml(active.table)} · Профил: ${escapeHtml(active.profile)} · Score: ${formatNumber(active.score)}`
      : "POST ще бъде спрян безопасно, докато не бъде открита реална таблица за складови движения.";

    bindingEl.innerHTML = `
      <div class="ag-binding-pill ${statusClass}">${statusText}</div>
      <div class="ag-binding-detail">${detail}</div>
      ${candidates.length ? `<div class="ag-binding-candidates">Кандидати: ${candidates.slice(0, 4).map((candidate) => escapeHtml(candidate.table)).join(" · ")}</div>` : ""}
    `;
  }

  function renderList() {
    if (!documents.length) {
      listEl.innerHTML = '<div class="ag-empty-state">Няма създадени документи.</div>';
      return;
    }

    listEl.innerHTML = documents.map((doc) => {
      const activeClass = activeDocument && activeDocument.id === doc.id ? " is-active" : "";
      const postedClass = doc.status === "POSTED" ? " is-posted" : "";
      const movementMeta = doc.status === "POSTED" ? ` · Trace: ${formatNumber(doc.postedMovementCount)} движения` : "";
      const auditMeta = doc.auditEventCount ? ` · Audit: ${formatNumber(doc.auditEventCount)}` : "";
      return `
        <button type="button" class="ag-adjustment-row${activeClass}${postedClass}" data-doc-id="${escapeHtml(doc.id)}">
          <span class="ag-adjustment-number">${escapeHtml(doc.number)}</span>
          <span class="ag-adjustment-status">${escapeHtml(statusLabel(doc.status))}</span>
          <span class="ag-adjustment-meta">Редове: ${formatNumber(doc.lineCount)} · Разлика: ${formatNumber(doc.totalDelta)}${movementMeta}${auditMeta}</span>
        </button>
      `;
    }).join("");
  }

  function renderDetails() {
    if (!activeDocument) {
      detailsEl.className = "ag-adjustment-details is-empty";
      detailsEl.innerHTML = '<div class="ag-empty-state">Избери документ от списъка.</div>';
      return;
    }

    const locked = activeDocument.status === "POSTED";
    const lines = Array.isArray(activeDocument.lines) ? activeDocument.lines : [];
    const postingLog = Array.isArray(activeDocument.postingLog) ? activeDocument.postingLog : [];
    const movementTrace = Array.isArray(activeDocument.movementTrace) ? activeDocument.movementTrace : [];
    const traceSummary = activeDocument.traceSummary || {};
    const auditTrail = Array.isArray(activeDocument.auditTrail) ? activeDocument.auditTrail : [];
    const auditSummary = activeDocument.auditSummary || {};
    detailsEl.className = "ag-adjustment-details" + (locked ? " is-locked" : "");
    detailsEl.innerHTML = `
      <div class="ag-document-panel">
        <div class="ag-card-title-row">
          <div>
            <h3>${escapeHtml(activeDocument.number)}</h3>
            <p>${escapeHtml(statusLabel(activeDocument.status))}${activeDocument.movementBindingTable ? " · " + escapeHtml(activeDocument.movementBindingTable) : ""}</p>
          </div>
          <button type="button" class="ag-btn ag-btn-danger" id="agPostAdjustmentBtn" ${locked ? "disabled" : ""}>POSTED / Осчетоводи</button>
        </div>
        <div class="ag-document-note">${escapeHtml(activeDocument.reason || "Складова корекция")}</div>
        ${locked ? `
          <div class="ag-posted-lock-panel">
            <strong>POSTED · документът е заключен</strong>
            <span>Осчетоводено: ${escapeHtml(activeDocument.postedAt || "-")} · От: ${escapeHtml(activeDocument.postedBy || "-")}</span>
            <span>Trace движения: ${formatNumber(traceSummary.movementCount || activeDocument.postedMovementCount || 0)} · Таблица: ${escapeHtml((traceSummary.tables || [activeDocument.movementBindingTable || ""])[0] || "-")}</span>
            <span>Audit събития: ${formatNumber(auditSummary.eventCount || activeDocument.auditEventCount || 0)} · Последно: ${escapeHtml(auditSummary.lastEventAt || activeDocument.lastAuditAt || "-")}</span>
          </div>
        ` : `
          <div class="ag-draft-trace-note">Movement trace ще се появи след POSTED. DRAFT документът няма реален складов ефект.</div>
        `}
      </div>

      <form id="agLineForm" class="ag-line-form" ${locked ? "data-locked=\"true\"" : ""}>
        <h3>Ред за корекция</h3>
        <div class="ag-line-grid">
          <label>Item ID<input name="itemId" required ${locked ? "disabled" : ""} /></label>
          <label>Код<input name="itemCode" ${locked ? "disabled" : ""} /></label>
          <label>Име<input name="itemName" value="Артикул" ${locked ? "disabled" : ""} /></label>
          <label>Обект / склад<input name="warehouseId" ${locked ? "disabled" : ""} /></label>
          <label>Текущо<input name="currentQuantity" type="number" step="0.001" value="0" ${locked ? "disabled" : ""} /></label>
          <label>Преброено<input name="countedQuantity" type="number" step="0.001" value="0" ${locked ? "disabled" : ""} /></label>
        </div>
        <button type="submit" class="ag-btn ag-btn-secondary" ${locked ? "disabled" : ""}>Добави ред</button>
      </form>

      <div class="ag-lines-table-wrap">
        <table class="ag-lines-table">
          <thead>
            <tr>
              <th>Артикул</th>
              <th>Склад</th>
              <th>Текущо</th>
              <th>Преброено</th>
              <th>Разлика</th>
              <th>Movement</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            ${lines.length ? lines.map((line) => `
              <tr>
                <td><strong>${escapeHtml(line.itemName || line.itemId)}</strong><br><small>${escapeHtml(line.itemId)}</small></td>
                <td>${escapeHtml(line.warehouseId || "-")}</td>
                <td>${formatNumber(line.currentQuantity)}</td>
                <td>${formatNumber(line.countedQuantity)}</td>
                <td class="${Number(line.deltaQuantity) >= 0 ? "is-positive" : "is-negative"}">${formatNumber(line.deltaQuantity)}</td>
                <td>${line.postedMovementId ? `<span class="ag-movement-chip">${escapeHtml(line.postedMovementTable || "movement")} · ${escapeHtml(line.postedMovementId)}</span>` : "-"}</td>
                <td>${locked ? "🔒" : `<button type="button" class="ag-link-button" data-delete-line="${escapeHtml(line.id)}">Изтрий</button>`}</td>
              </tr>
            `).join("") : '<tr><td colspan="7" class="ag-empty-cell">Няма редове.</td></tr>'}
          </tbody>
        </table>
      </div>

      <div class="ag-movement-trace-panel ${movementTrace.length ? "has-trace" : "is-empty"}">
        <div class="ag-card-title-row">
          <div>
            <h3>Movement trace visibility</h3>
            <p>${movementTrace.length ? "Line-to-movement връзки от POSTED документа към реалния stock movement журнал." : "Все още няма movement trace. Той се създава само след POSTED."}</p>
          </div>
          <button type="button" class="ag-btn ag-btn-secondary" id="agReloadTraceBtn" ${!activeDocument ? "disabled" : ""}>Обнови trace</button>
        </div>
        <div class="ag-trace-summary-grid">
          <div><strong>${formatNumber(traceSummary.movementCount || 0)}</strong><span>Движения</span></div>
          <div><strong>${formatNumber(traceSummary.totalQuantityDelta || 0)}</strong><span>Обща разлика</span></div>
          <div><strong>${formatNumber(traceSummary.positiveCount || 0)}</strong><span>IN</span></div>
          <div><strong>${formatNumber(traceSummary.negativeCount || 0)}</strong><span>OUT</span></div>
        </div>
        ${movementTrace.length ? `
          <div class="ag-trace-table-wrap">
            <table class="ag-lines-table ag-trace-table">
              <thead>
                <tr>
                  <th>Movement table</th>
                  <th>Movement ID</th>
                  <th>Ред</th>
                  <th>Посока</th>
                  <th>Разлика</th>
                  <th>Binding</th>
                  <th>Posted</th>
                </tr>
              </thead>
              <tbody>
                ${movementTrace.map((row) => `
                  <tr>
                    <td><strong>${escapeHtml(row.movementTable)}</strong></td>
                    <td><span class="ag-movement-chip">${escapeHtml(row.movementId)}</span></td>
                    <td>${escapeHtml(row.itemName || row.itemId || row.lineId)}<br><small>${escapeHtml(row.lineId)}</small></td>
                    <td>${escapeHtml(row.movementDirection || "-")}</td>
                    <td class="${Number(row.quantityDelta) >= 0 ? "is-positive" : "is-negative"}">${formatNumber(row.quantityDelta)}</td>
                    <td>${escapeHtml(row.bindingProfile || "-")}</td>
                    <td>${escapeHtml(row.createdAt || "-")}<br><small>${escapeHtml(row.postedBy || "-")}</small></td>
                  </tr>
                `).join("")}
              </tbody>
            </table>
          </div>
        ` : ""}
      </div>

      <div class="ag-audit-safety-panel ${locked ? "is-locked" : ""}">
        <div class="ag-card-title-row">
          <div>
            <h3>Audit / Reversal safety</h3>
            <p>${auditTrail.length ? "Append-only audit trail за действията по документа." : "Audit trail ще се попълва при действия по документа."}</p>
          </div>
          <button type="button" class="ag-btn ag-btn-secondary" id="agReloadAuditBtn">Обнови audit</button>
        </div>
        <div class="ag-audit-summary-grid">
          <div><strong>${formatNumber(auditSummary.eventCount || 0)}</strong><span>Audit събития</span></div>
          <div><strong>${escapeHtml((auditSummary.reasonCodes || ["-"])[0] || "-")}</strong><span>Reason code</span></div>
          <div><strong>${escapeHtml((auditSummary.actors || ["-"])[0] || "-")}</strong><span>Потребител</span></div>
          <div><strong>${escapeHtml(auditSummary.lastEventAt || "-")}</strong><span>Последно</span></div>
        </div>
        ${auditTrail.length ? `
          <div class="ag-audit-list">
            ${auditTrail.slice(0, 12).map((row) => `
              <div class="ag-audit-row">
                <div><strong>${escapeHtml(row.eventType)}</strong><small>${escapeHtml(row.createdAt || "-")}</small></div>
                <div><span>${escapeHtml(row.reasonCode || "OTHER")}</span><small>${escapeHtml(row.actor || "system")}</small></div>
                <div><span>${escapeHtml(row.reasonText || "-")}</span><small>${escapeHtml(row.eventScope || "document")}</small></div>
              </div>
            `).join("")}
          </div>
        ` : ""}
        ${locked ? `
          <div class="ag-reversal-box">
            <strong>Безопасна обратна корекция</strong>
            <p>Не редактира POSTED документа и не трие movement записи. Създава нов DRAFT документ с обратни редове.</p>
            <div class="ag-reversal-actions">
              <button type="button" class="ag-btn ag-btn-secondary" id="agPreviewReversalBtn">Preview reversal</button>
              <button type="button" class="ag-btn ag-btn-primary" id="agCreateReversalDraftBtn">Създай обратен DRAFT</button>
            </div>
            <div id="agReversalPreview" class="ag-reversal-preview" hidden></div>
          </div>
        ` : `
          <div class="ag-reversal-box">
            <strong>Reversal safety</strong>
            <p>Обратна корекция се подготвя само за POSTED документ.</p>
          </div>
        `}
      </div>

      ${postingLog.length ? `
        <div class="ag-posting-log">
          <h3>Posting log raw audit</h3>
          ${postingLog.map((row) => `
            <div class="ag-posting-log-row">
              <strong>${escapeHtml(row.movement_table)}</strong>
              <span>${escapeHtml(row.movement_id)} · ${escapeHtml(row.movement_direction || "") } · ${formatNumber(row.quantity_delta)}</span>
            </div>
          `).join("")}
        </div>
      ` : ""}
    `;
  }

  async function loadDocuments() {
    const payload = await api("/api/stock/adjustments/documents");
    documents = payload.documents || [];
    renderList();
  }

  async function loadBinding() {
    const payload = await api("/api/stock/adjustments/movement-binding");
    movementBinding = payload.movementBinding;
    renderBinding();
  }

  async function loadDocument(id) {
    const payload = await api("/api/stock/adjustments/documents/" + encodeURIComponent(id));
    activeDocument = payload.document;
    renderList();
    renderDetails();
  }

  async function loadTrace() {
    if (!activeDocument) return;
    const payload = await api("/api/stock/adjustments/documents/" + encodeURIComponent(activeDocument.id) + "/movement-trace");
    activeDocument.movementTrace = payload.movementTrace || [];
    activeDocument.traceSummary = payload.traceSummary || {};
    renderDetails();
  }

  async function loadAudit() {
    if (!activeDocument) return;
    const payload = await api("/api/stock/adjustments/documents/" + encodeURIComponent(activeDocument.id) + "/audit");
    activeDocument.auditTrail = payload.auditTrail || [];
    activeDocument.auditSummary = payload.auditSummary || {};
    renderDetails();
  }

  async function previewReversal() {
    if (!activeDocument) return;
    const payload = await api("/api/stock/adjustments/documents/" + encodeURIComponent(activeDocument.id) + "/reversal-preview");
    const box = document.getElementById("agReversalPreview");
    if (!box) return;
    box.hidden = false;
    box.innerHTML = `Редове: ${formatNumber(payload.reversal && payload.reversal.lineCount)} · Обща обратна разлика: ${formatNumber(payload.reversal && payload.reversal.totalDelta)}<br><small>Старият journal не се редактира. Ще се създаде нов DRAFT документ.</small>`;
  }

  async function createReversalDraft() {
    if (!activeDocument) return;
    if (!confirm("Да създам ли нов обратен DRAFT документ? Старият POSTED документ няма да се редактира.")) return;
    const payload = await api("/api/stock/adjustments/documents/" + encodeURIComponent(activeDocument.id) + "/reversal-draft", {
      method: "POST",
      body: JSON.stringify({ actor: "AutoGrand", reason: "Обратна корекция" })
    });
    activeDocument = payload.document;
    await loadDocuments();
    renderDetails();
  }

  listEl.addEventListener("click", (event) => {
    const row = event.target.closest("[data-doc-id]");
    if (!row) return;
    loadDocument(row.dataset.docId).catch((error) => alert(error.message));
  });

  reloadBtn.addEventListener("click", () => {
    loadDocuments().catch((error) => alert(error.message));
  });

  reloadBindingBtn.addEventListener("click", () => {
    loadBinding().catch((error) => alert(error.message));
  });

  createForm.addEventListener("submit", async (event) => {
    event.preventDefault();
    const form = new FormData(createForm);
    try {
      const payload = await api("/api/stock/adjustments/documents", {
        method: "POST",
        body: JSON.stringify({ reason: form.get("reason"), note: form.get("note") })
      });
      activeDocument = payload.document;
      await loadDocuments();
      renderDetails();
      createForm.reset();
      createForm.elements.reason.value = "Складова корекция";
    } catch (error) {
      alert(error.message);
    }
  });

  detailsEl.addEventListener("submit", async (event) => {
    if (event.target.id !== "agLineForm") return;
    event.preventDefault();
    if (!activeDocument) return;
    const form = new FormData(event.target);
    try {
      const payload = await api("/api/stock/adjustments/documents/" + encodeURIComponent(activeDocument.id) + "/lines", {
        method: "POST",
        body: JSON.stringify({
          itemId: form.get("itemId"),
          itemCode: form.get("itemCode"),
          itemName: form.get("itemName"),
          warehouseId: form.get("warehouseId"),
          currentQuantity: form.get("currentQuantity"),
          countedQuantity: form.get("countedQuantity")
        })
      });
      activeDocument = payload.document;
      await loadDocuments();
      renderDetails();
    } catch (error) {
      alert(error.message);
    }
  });

  detailsEl.addEventListener("click", async (event) => {
    if (event.target.id === "agReloadAuditBtn") {
      try {
        await loadAudit();
      } catch (error) {
        alert(error.message);
      }
      return;
    }

    if (event.target.id === "agPreviewReversalBtn") {
      try {
        await previewReversal();
      } catch (error) {
        alert(error.message);
      }
      return;
    }

    if (event.target.id === "agCreateReversalDraftBtn") {
      try {
        await createReversalDraft();
      } catch (error) {
        alert(error.message);
      }
      return;
    }

    if (event.target.id === "agReloadTraceBtn") {
      try {
        await loadTrace();
      } catch (error) {
        alert(error.message);
      }
      return;
    }

    const deleteButton = event.target.closest("[data-delete-line]");
    if (deleteButton && activeDocument) {
      try {
        const payload = await api(
          "/api/stock/adjustments/documents/" + encodeURIComponent(activeDocument.id) + "/lines/" + encodeURIComponent(deleteButton.dataset.deleteLine),
          { method: "DELETE" }
        );
        activeDocument = payload.document;
        await loadDocuments();
        renderDetails();
      } catch (error) {
        alert(error.message);
      }
      return;
    }

    if (event.target.id === "agPostAdjustmentBtn" && activeDocument) {
      if (!confirm("Да осчетоводя ли документа? След POSTED той ще бъде заключен и ще създаде bound stock movement.")) return;
      try {
        const payload = await api("/api/stock/adjustments/documents/" + encodeURIComponent(activeDocument.id) + "/post", {
          method: "POST",
          body: JSON.stringify({ postedBy: "AutoGrand" })
        });
        activeDocument = payload.document;
        await loadDocuments();
        await loadBinding();
        renderDetails();
      } catch (error) {
        alert(error.message);
      }
    }
  });

  renderBinding();
  renderList();
  renderDetails();
})();
</script>
