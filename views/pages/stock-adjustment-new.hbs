<section class="document-card-screen stock-form-screen">
  <header class="document-card-header">
    <div class="screen-title-block">
      <div class="screen-kicker">Склад</div>
      <h1>Складова корекция</h1>
      <p>Ръчен вход или изход за изравняване на реалната наличност.</p>
    </div>

    <div class="document-card-actions">
      <a href="/stock/dashboard">Складов център</a>
      <a href="/screen/stock">Наличности</a>
      <a href="/screen/stock-movements">Движения</a>
    </div>
  </header>

  {{#if actionMessage}}
    <div class="document-alert error">{{actionMessage}}</div>
  {{/if}}

  <form class="stock-form-card" method="post" action="/stock/adjustment/new">
    <div class="stock-form-grid">
      <label>
        <span>Склад</span>
        <select name="warehouseId" required>
          <option value="">Избери склад...</option>
          {{#each formData.warehouses}}
            <option value="{{id}}">{{label}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        <span>Артикул</span>
        <select name="itemId" required>
          <option value="">Избери артикул...</option>
          {{#each formData.items}}
            <option value="{{id}}">{{label}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        <span>Посока</span>
        <select name="direction" required>
          {{#each formData.directions}}
            <option value="{{value}}">{{label}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        <span>Количество</span>
        <input name="quantity" type="number" step="0.001" min="0.001" required placeholder="0.000" />
      </label>

      <label class="wide">
        <span>Основание</span>
        <input name="reason" type="text" placeholder="Инвентаризация, корекция, бракуване..." />
      </label>

      <label class="wide">
        <span>Бележка</span>
        <textarea name="note" rows="3" placeholder="Допълнителна информация"></textarea>
      </label>
    </div>

    <div class="document-card-actions stock-form-actions">
      <button type="submit">Запиши корекция</button>
      <a href="/stock/dashboard">Отказ</a>
    </div>
  </form>
</section>
