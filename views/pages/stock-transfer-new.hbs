<section class="document-card-screen stock-form-screen">
  <header class="document-card-header">
    <div class="screen-title-block">
      <div class="screen-kicker">Склад / Нов документ</div>
      <h1>Нов складов трансфер</h1>
      <p>Създава се документ в статус Чернова. Складовите движения се записват чак при публикуване.</p>
    </div>

    <div class="document-card-actions">
      <a href="/stock/dashboard">Складов център</a>
      <a href="/stock/transfers">Трансфери и заявки</a>
      <a href="/screen/stock">Наличности</a>
    </div>
  </header>

  {{#if actionMessage}}
    <div class="document-alert error">{{actionMessage}}</div>
  {{/if}}

  <form class="stock-form-card" method="post" action="/stock/transfer/new">
    <div class="stock-form-grid">
      <label>
        <span>От склад / обект</span>
        <select name="fromWarehouseId" required>
          <option value="">Избери изходен склад...</option>
          {{#each formData.warehouses}}
            <option value="{{id}}">{{label}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        <span>Към склад / обект</span>
        <select name="toWarehouseId" required>
          <option value="">Избери приемащ склад...</option>
          {{#each formData.warehouses}}
            <option value="{{id}}">{{label}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        <span>Първи ред — артикул</span>
        <select name="itemId">
          <option value="">Без начален ред...</option>
          {{#each formData.items}}
            <option value="{{id}}">{{label}}</option>
          {{/each}}
        </select>
      </label>

      <label>
        <span>Количество</span>
        <input name="quantity" type="number" step="0.001" min="0.001" placeholder="0.000" />
      </label>

      <label class="wide">
        <span>За кого / причина за трансфера</span>
        <textarea name="note" rows="3" placeholder="Незадължително: напр. зареждане на обект или част за конкретен клиент"></textarea>
      </label>
    </div>

    <div class="document-card-actions stock-form-actions">
      <button type="submit">Създай документ</button>
      <a href="/stock/dashboard">Отказ</a>
    </div>
  </form>
</section>
