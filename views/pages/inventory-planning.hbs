<section class="ag-step-412 module-page" data-module="inventory-planning" data-step="4.12">
  <header class="module-hero ag-step-412__hero">
    <div>
      <p class="module-kicker">Планиране · Само анализ</p>
      <h1>Планиране на наличности</h1>
      <p class="module-lead">
        Минимални количества, предложения за дозареждане, бавнодвижещи се артикули и риск от изчерпване без автоматично създаване на документи.
      </p>
    </div>
    <div class="ag-step-412__guard-card">
      <strong>Само анализ</strong>
      <span>POSTED документите остават заключени. Stock journal не се редактира.</span>
    </div>
  </header>

  <section class="ag-step-412__summary-grid" aria-label="Мениджърски преглед">
    <article class="ag-step-412__metric">
      <span>Артикули</span>
      <strong>{{snapshot.summary.totalItems}}</strong>
      <small>източник: {{snapshot.sourceName}}</small>
    </article>
    <article class="ag-step-412__metric is-warning">
      <span>За дозареждане</span>
      <strong>{{snapshot.summary.reorderCount}}</strong>
      <small>под минимално / целево ниво</small>
    </article>
    <article class="ag-step-412__metric is-danger">
      <span>Риск от изчерпване</span>
      <strong>{{snapshot.summary.outOfStockRiskCount}}</strong>
      <small>критично или под минимум</small>
    </article>
    <article class="ag-step-412__metric is-muted">
      <span>Бавно движение</span>
      <strong>{{snapshot.summary.slowMovingCount}}</strong>
      <small>над прага за дни без движение</small>
    </article>
  </section>

  <section class="ag-step-412__manager-panel">
    <div>
      <h2>Мениджърски преглед</h2>
      <p>{{snapshot.managerSnapshot.nextAction}}</p>
    </div>
    <div class="ag-step-412__status-pill">{{snapshot.summary.managerStatus}}</div>
  </section>

  <section class="module-card ag-step-412__card">
    <div class="module-card-header">
      <div>
        <p class="module-kicker">Reorder suggestions</p>
        <h2>Предложения за дозареждане</h2>
      </div>
      <span class="ag-step-412__readonly-badge">само анализ</span>
    </div>

    <div class="ag-step-412__table-wrap">
      <table class="ag-step-412__table">
        <thead>
          <tr>
            <th>Код</th>
            <th>Артикул</th>
            <th>Склад</th>
            <th class="num">Наличност</th>
            <th class="num">Резерв.</th>
            <th class="num">Входящо</th>
            <th class="num">Проектна</th>
            <th class="num">Мин.</th>
            <th class="num">Предл.</th>
            <th>Риск</th>
          </tr>
        </thead>
        <tbody>
          {{#each snapshot.items}}
            <tr class="risk-{{riskLevel}}">
              <td><strong>{{itemCode}}</strong></td>
              <td>
                <span>{{itemName}}</span>
                <small>{{groupName}}</small>
              </td>
              <td>{{warehouseName}}</td>
              <td class="num">{{currentQty}}</td>
              <td class="num">{{reservedQty}}</td>
              <td class="num">{{inboundQty}}</td>
              <td class="num"><strong>{{projectedAvailableQty}}</strong></td>
              <td class="num">{{minimumQty}}</td>
              <td class="num"><strong>{{recommendedOrderQty}}</strong></td>
              <td>
                <span class="ag-step-412__risk ag-step-412__risk--{{riskLevel}}">{{riskLabel}}</span>
                <small>{{priorityLabel}}</small>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ag-step-412__split">
    <article class="module-card ag-step-412__card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Бавно движение</p>
          <h2>Бавнодвижещи се артикули</h2>
        </div>
      </div>
      {{#if snapshot.slowMovingItems.length}}
        <ul class="ag-step-412__list">
          {{#each snapshot.slowMovingItems}}
            <li>
              <strong>{{itemCode}}</strong>
              <span>{{itemName}}</span>
              <small>{{daysSinceLastMovement}} дни без движение · наличност {{currentQty}}</small>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="ag-step-412__empty">Няма артикули над прага за бавно движение.</p>
      {{/if}}
    </article>

    <article class="module-card ag-step-412__card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Риск от изчерпване</p>
          <h2>Риск от изчерпване</h2>
        </div>
      </div>
      {{#if snapshot.outOfStockRiskItems.length}}
        <ul class="ag-step-412__list">
          {{#each snapshot.outOfStockRiskItems}}
            <li>
              <strong>{{itemCode}}</strong>
              <span>{{itemName}}</span>
              <small>{{riskLabel}} · проектна наличност {{projectedAvailableQty}} · минимум {{minimumQty}}</small>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="ag-step-412__empty">Няма критичен риск според текущия snapshot.</p>
      {{/if}}
    </article>
  </section>

  <footer class="ag-step-412__footer-note">
    <strong>Ограничения:</strong>
    {{#each snapshot.guardrails}}
      <span>{{this}}</span>
    {{/each}}
  </footer>
</section>
