<section class="ag-step-413 ag-step-412 ag-step-4121 ag-step-4123 module-page" data-module="purchase-planning" data-step="4.13">
  <header class="module-hero ag-step-412__hero ag-step-413__hero">
    <div>
      <p class="module-kicker">Purchase Planning · Procurement Decision Center · Само анализ</p>
      <h1>Планиране на покупки</h1>
      <p class="module-lead">
        Procurement decision center над supplier planning snapshot: групира критичните доставчици, бюджетните сигнали и редовете за ръчно purchase решение.
      </p>
      <div class="ag-step-4121__hero-meta">
        <span>Step: {{decisionCenter.step}}</span>
        <span>Health: {{decisionCenter.healthLabel}}</span>
        <span>Източник: {{decisionCenter.sourceName}}</span>
        <span>API: {{decisionCenter.apiHref}}</span>
      </div>
    </div>
    <div class="ag-step-412__guard-card ag-step-413__guard-card">
      <strong>Read-only procurement</strong>
      <span>Няма автоматично създаване на purchase документ, няма stock posting и няма journal mutation.</span>
      <a class="ag-step-4123__supplier-cta" href="{{decisionCenter.supplierPlanningHref}}">Supplier planning</a>
    </div>
  </header>

  <section class="ag-step-4121__command-strip ag-step-413__command-strip" aria-label="Procurement decision status">
    <div class="ag-step-4121__command-main">
      <span class="ag-step-4121__status-dot tone-{{decisionCenter.summary.statusTone}}"></span>
      <div>
        <p class="module-kicker">Procurement status</p>
        <h2>{{decisionCenter.summary.statusLabel}}</h2>
        <p>{{decisionCenter.summary.nextAction}}</p>
      </div>
    </div>
    <div class="ag-step-4121__snapshot-note tone-{{decisionCenter.summary.budgetBand.tone}}">
      <strong>{{decisionCenter.summary.budgetBand.label}}</strong>
      <span>{{decisionCenter.summary.budgetBand.note}}</span>
    </div>
    <a class="ag-step-413__manual-purchase" href="{{decisionCenter.manualPurchaseHref}}">Ръчна purchase поръчка</a>
  </section>

  <section class="ag-step-412__summary-grid ag-step-4121__summary-grid ag-step-413__summary-grid" aria-label="Procurement KPI cards">
    <article class="ag-step-412__metric ag-step-4121__metric is-danger">
      <span>Спешни доставчици</span>
      <strong>{{decisionCenter.summary.urgentSuppliers}}</strong>
      <small>{{decisionCenter.summary.criticalSuppliers}} критични supplier сигнала</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric is-warning">
      <span>Доставчици с покупка</span>
      <strong>{{decisionCenter.summary.suppliersWithPurchase}}</strong>
      <small>от {{decisionCenter.summary.supplierCount}} доставчици в snapshot</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric is-money">
      <span>Ориентировъчна стойност</span>
      <strong>{{decisionCenter.summary.displayRecommendedValueTotal}}</strong>
      <small>{{decisionCenter.summary.displayRecommendedQtyTotal}} общо предложено количество</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric">
      <span>Purchase редове</span>
      <strong>{{decisionCenter.summary.totalPurchaseLines}}</strong>
      <small>редове за човешки преглед</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric is-muted">
      <span>Бюджетен праг</span>
      <strong>{{decisionCenter.policy.displayBudgetWarningLimit}}</strong>
      <small>review праг {{decisionCenter.policy.displayBudgetReviewLimit}}</small>
    </article>
  </section>

  <section class="ag-step-413__coverage-strip" aria-label="Procurement coverage">
    <article>
      <span>Складове</span>
      <strong>{{decisionCenter.warehouseCoverage}}</strong>
    </article>
    <article>
      <span>Групи</span>
      <strong>{{decisionCenter.groupCoverage}}</strong>
    </article>
    <article>
      <span>Ръчно решение</span>
      <strong>purchase документ се създава само от оператор</strong>
    </article>
  </section>

  {{#if decisionCenter.selectedSupplierActive}}
    <section class="module-card ag-step-412__card ag-step-413__focus-card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Selected supplier focus</p>
          <h2>{{decisionCenter.selectedSupplier.supplierName}}</h2>
          <p class="ag-step-4122__inline-note">{{decisionCenter.selectedSupplier.decisionNextAction}}</p>
        </div>
        <span class="ag-step-4123__supplier-priority tone-{{decisionCenter.selectedSupplier.priority}}">{{decisionCenter.selectedSupplier.decisionLabel}}</span>
      </div>
      <div class="ag-step-413__focus-grid">
        <span>Редове: <strong>{{decisionCenter.selectedSupplier.reorderLineCount}}</strong></span>
        <span>Стойност: <strong>{{decisionCenter.selectedSupplier.displayRecommendedOrderValueTotal}}</strong></span>
        <span>Бюджет: <strong>{{decisionCenter.selectedSupplier.budgetBand.label}}</strong></span>
        <a href="{{decisionCenter.selectedSupplier.supplierInventoryHref}}">Отвори supplier inspector</a>
      </div>
    </section>
  {{/if}}

  <section class="ag-step-4121__lanes ag-step-413__lanes" aria-label="Procurement decision lanes">
    {{#each decisionCenter.decisionLanes}}
      <article class="module-card ag-step-412__card ag-step-4121__lane ag-step-413__lane tone-{{tone}}">
        <div class="module-card-header">
          <div>
            <p class="module-kicker">{{note}}</p>
            <h2>{{title}}</h2>
          </div>
          <span class="ag-step-412__readonly-badge">{{count}}</span>
        </div>
        {{#if suppliers.length}}
          <ul class="ag-step-413__supplier-list">
            {{#each suppliers}}
              <li>
                <a href="{{supplierProcurementHref}}"><strong>{{supplierName}}</strong></a>
                <span>{{decisionLabel}} · {{displayRecommendedOrderValueTotal}}</span>
                <small>{{decisionNextAction}}</small>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="ag-step-412__empty">{{empty}}</p>
        {{/if}}
      </article>
    {{/each}}
  </section>

  <section class="module-card ag-step-412__card ag-step-413__table-card">
    <div class="module-card-header">
      <div>
        <p class="module-kicker">Supplier decision workbench</p>
        <h2>Procurement решения по доставчици</h2>
        <p class="ag-step-4122__inline-note">Таблицата е работен списък. Purchase документът се създава само ръчно след проверка.</p>
      </div>
      <span class="ag-step-412__readonly-badge">decision-support</span>
    </div>
    <div class="ag-step-412__table-wrap">
      <table class="ag-step-412__table ag-step-413__decision-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Доставчик</th>
            <th>Решение</th>
            <th class="num">Редове</th>
            <th class="num">Критични</th>
            <th class="num">Количество</th>
            <th class="num">Стойност</th>
            <th>Бюджет</th>
            <th>Инспектор</th>
          </tr>
        </thead>
        <tbody>
          {{#each decisionCenter.suppliers}}
            <tr class="procurement-{{readiness.tone}}">
              <td class="num">{{decisionRank}}</td>
              <td>
                <a href="{{supplierProcurementHref}}"><strong>{{supplierName}}</strong></a>
                <small>{{warehouseList}} · {{groupList}}</small>
              </td>
              <td>
                <span class="ag-step-413__decision-pill tone-{{readiness.tone}}">{{decisionLabel}}</span>
                <small>{{decisionNextAction}}</small>
              </td>
              <td class="num">{{reorderLineCount}}</td>
              <td class="num">{{criticalCount}}</td>
              <td class="num">{{displayRecommendedOrderQtyTotal}}</td>
              <td class="num"><strong>{{displayRecommendedOrderValueTotal}}</strong></td>
              <td>
                <span class="ag-step-413__budget tone-{{budgetBand.tone}}">{{budgetBand.label}}</span>
                <small>{{budgetBand.note}}</small>
              </td>
              <td>
                <a class="ag-step-4122__detail-link" href="{{supplierInventoryHref}}">Supplier</a>
                <small>inventory planning</small>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ag-step-4122__detail-grid ag-step-413__detail-grid">
    <article class="module-card ag-step-412__card ag-step-413__workflow-card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Manual workflow</p>
          <h2>Ръчна procurement последователност</h2>
        </div>
        <span class="ag-step-412__readonly-badge">no mutation</span>
      </div>
      <ol class="ag-step-413__workflow">
        {{#each decisionCenter.manualWorkflow}}
          <li class="tone-{{tone}}">
            <strong>{{order}}. {{title}}</strong>
            <span>{{description}}</span>
          </li>
        {{/each}}
      </ol>
    </article>

    <article class="module-card ag-step-412__card ag-step-413__top-lines-card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Top purchase lines</p>
          <h2>Редове за първи преглед</h2>
        </div>
      </div>
      <ul class="ag-step-413__line-list">
        {{#each decisionCenter.topPurchaseLines}}
          <li>
            <a href="{{detailHref}}"><strong>{{itemCode}}</strong></a>
            <span>{{itemName}} · {{supplierName}}</span>
            <small>{{warehouseName}} · предл. {{displayRecommendedOrderQty}} · {{displayRecommendedOrderValue}}</small>
          </li>
        {{/each}}
      </ul>
    </article>
  </section>

  <section class="module-card ag-step-412__card ag-step-413__links-card">
    <div class="module-card-header">
      <div>
        <p class="module-kicker">Upstream / downstream links</p>
        <h2>Връзки към съществуващите екрани</h2>
      </div>
    </div>
    <ul class="ag-step-413__link-list">
      {{#each decisionCenter.upstreamLinks}}
        <li>
          <a href="{{href}}"><strong>{{label}}</strong></a>
          <span>{{note}}</span>
        </li>
      {{/each}}
    </ul>
  </section>

  <footer class="ag-step-412__footer-note ag-step-4121__footer-note ag-step-413__footer-note">
    <strong>Guardrails:</strong>
    {{#each decisionCenter.guardrails}}
      <span>{{this}}</span>
    {{/each}}
  </footer>
</section>
