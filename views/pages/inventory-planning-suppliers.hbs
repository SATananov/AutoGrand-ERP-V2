<section class="ag-step-412 ag-step-4121 ag-step-4122 ag-step-4123 module-page" data-module="inventory-planning-suppliers" data-step="4.12.3">
  <header class="module-hero ag-step-412__hero ag-step-4123__supplier-hero">
    <div>
      <p class="module-kicker">Inventory Planning · Supplier view · Purchase recommendations · Само анализ</p>
      <h1>Доставчици и purchase препоръки</h1>
      <p class="module-lead">
        Групира reorder нуждите по доставчик, склад и група, за да помогне на управителя да планира покупка ръчно.
      </p>
      <div class="ag-step-4121__hero-meta">
        <span>Snapshot: {{supplierSnapshot.step}}</span>
        <span>Източник: {{supplierSnapshot.sourceName}}</span>
        <span>API: {{supplierSnapshot.apiHref}}</span>
      </div>
    </div>
    <div class="ag-step-412__guard-card ag-step-4123__supplier-guard">
      <strong>Read-only purchase planning</strong>
      <span>Няма автоматично създаване на purchase документи. Няма промяна на journal logic.</span>
      <a class="ag-step-4122__back" href="{{supplierSnapshot.backHref}}">← Назад към planning dashboard</a>
    </div>
  </header>

  <section class="ag-step-4121__command-strip ag-step-4123__supplier-strip" aria-label="Supplier purchase status">
    <div class="ag-step-4121__command-main">
      <span class="ag-step-4121__status-dot tone-{{supplierSnapshot.managerSupplierSnapshot.statusTone}}"></span>
      <div>
        <p class="module-kicker">{{supplierSnapshot.managerSupplierSnapshot.title}}</p>
        <h2>{{supplierSnapshot.managerSupplierSnapshot.statusLabel}}</h2>
        <p>{{supplierSnapshot.managerSupplierSnapshot.nextAction}}</p>
      </div>
    </div>
    <div class="ag-step-4121__snapshot-note">
      <strong>Правило</strong>
      <span>{{supplierSnapshot.managerSupplierSnapshot.safetyNote}}</span>
    </div>
  </section>

  <section class="ag-step-412__summary-grid ag-step-4121__summary-grid ag-step-4123__supplier-kpis" aria-label="Supplier KPI cards">
    <article class="ag-step-412__metric ag-step-4121__metric is-warning">
      <span>Доставчици с покупка</span>
      <strong>{{supplierSnapshot.supplierSummary.suppliersWithPurchase}}</strong>
      <small>от {{supplierSnapshot.supplierSummary.supplierCount}} доставчици</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric is-danger">
      <span>Критични доставчици</span>
      <strong>{{supplierSnapshot.supplierSummary.criticalSuppliers}}</strong>
      <small>имат артикули с out-of-stock риск</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric is-money">
      <span>Стойност за покупка</span>
      <strong>{{supplierSnapshot.supplierSummary.displayRecommendedValueTotal}}</strong>
      <small>ориентир, без автоматичен документ</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric">
      <span>Редове за преглед</span>
      <strong>{{supplierSnapshot.supplierSummary.totalPurchaseLines}}</strong>
      <small>{{supplierSnapshot.supplierSummary.displayRecommendedQtyTotal}} предложено количество</small>
    </article>
  </section>

  <section class="module-card ag-step-412__card ag-step-4123__supplier-table-card">
    <div class="module-card-header">
      <div>
        <p class="module-kicker">Supplier recommendation list</p>
        <h2>Purchase planning по доставчици</h2>
        <p class="ag-step-4122__inline-note">Изгледът само групира и препоръчва. Purchase документ се създава ръчно след проверка.</p>
      </div>
      <span class="ag-step-412__readonly-badge">read-only</span>
    </div>
    <div class="ag-step-412__table-wrap">
      <table class="ag-step-412__table ag-step-4123__supplier-table">
        <thead>
          <tr>
            <th>Доставчик</th>
            <th>Приоритет</th>
            <th class="num">Артикули</th>
            <th class="num">За покупка</th>
            <th class="num">Критични</th>
            <th class="num">Стойност</th>
            <th>Складове</th>
            <th>Групи</th>
            <th>Действие</th>
          </tr>
        </thead>
        <tbody>
          {{#each supplierSnapshot.supplierRecommendations}}
            <tr class="supplier-priority-{{priority}}">
              <td>
                <a href="{{supplierHref}}"><strong>{{supplierName}}</strong></a>
                <small>{{readOnlyNote}}</small>
              </td>
              <td>
                <span class="ag-step-4123__supplier-priority tone-{{priority}}">{{priorityLabel}}</span>
              </td>
              <td class="num">{{itemCount}}</td>
              <td class="num"><strong>{{reorderLineCount}}</strong></td>
              <td class="num">{{criticalCount}}</td>
              <td class="num">{{display.recommendedOrderValueTotal}}</td>
              <td>{{warehouseList}}</td>
              <td>{{groupList}}</td>
              <td>
                <span class="ag-step-4121__manual-action">{{manualActionLabel}}</span>
                <small>{{purchaseLineCount}} planning реда</small>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>

  <section class="ag-step-4121__lanes ag-step-4123__supplier-lanes" aria-label="Top supplier purchase lines">
    {{#each supplierSnapshot.managerSupplierSnapshot.topSuppliers}}
      <article class="module-card ag-step-412__card ag-step-4121__lane">
        <div class="module-card-header">
          <div>
            <p class="module-kicker">Top supplier</p>
            <h2><a href="{{supplierHref}}">{{supplierName}}</a></h2>
          </div>
          <span class="ag-step-412__readonly-badge">{{displayRecommendedOrderValueTotal}}</span>
        </div>
        <p>{{priorityLabel}} · {{manualActionLabel}}</p>
      </article>
    {{/each}}
  </section>

  <footer class="ag-step-412__footer-note ag-step-4121__footer-note ag-step-4123__footer-note">
    <strong>Guardrails:</strong>
    {{#each supplierSnapshot.guardrails}}
      <span>{{this}}</span>
    {{/each}}
  </footer>
</section>
