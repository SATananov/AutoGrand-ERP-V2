<section class="ag-step-412 ag-step-4121 ag-step-4122 module-page" data-module="inventory-planning-detail" data-step="4.12.2">
  <header class="module-hero ag-step-412__hero ag-step-4122__detail-hero">
    <div>
      <p class="module-kicker">Inventory Planning · Detail inspector · Само анализ</p>
      <h1>{{detail.item.itemCode}} · {{detail.item.itemName}}</h1>
      <p class="module-lead">
        Item planning drilldown за наличност по обекти, последни движения, причина за reorder и ръчна мениджърска препоръка.
      </p>
      <div class="ag-step-4121__hero-meta">
        <span>Snapshot: {{detail.step}}</span>
        <span>Източник: {{detail.sourceName}}</span>
        <span>Група: {{detail.item.groupName}}</span>
      </div>
    </div>
    <div class="ag-step-412__guard-card ag-step-4122__guard-card">
      <strong>Read-only detail</strong>
      <span>Няма автоматични документи. Няма редакция на stock journal. POSTED документите остават locked.</span>
      <a class="ag-step-4122__back" href="{{detail.backHref}}">← Назад към планиране</a>
    </div>
  </header>

  <section class="ag-step-4122__item-strip" aria-label="Item planning status">
    <div>
      <p class="module-kicker">Текущ риск</p>
      <h2>{{detail.item.riskLabel}}</h2>
      <span>{{detail.item.priorityLabel}} · {{detail.item.coverageLabel}}</span>
    </div>
    <div>
      <p class="module-kicker">Ръчно действие</p>
      <h2>{{detail.manualRecommendation.title}}</h2>
      <span>{{detail.manualRecommendation.explanation}}</span>
    </div>
    <div>
      <p class="module-kicker">API</p>
      <h2>JSON drilldown</h2>
      <span>{{detail.apiHref}}</span>
    </div>
  </section>

  <section class="ag-step-412__summary-grid ag-step-4122__summary-grid" aria-label="Item KPI cards">
    <article class="ag-step-412__metric ag-step-4121__metric">
      <span>Наличност</span>
      <strong>{{detail.item.display.currentQty}}</strong>
      <small>{{detail.item.warehouseName}}</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric is-warning">
      <span>Резервирано</span>
      <strong>{{detail.item.display.reservedQty}}</strong>
      <small>участва в проектната наличност</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric">
      <span>Входящо</span>
      <strong>{{detail.item.display.inboundQty}}</strong>
      <small>очаквано, само за анализ</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric is-danger">
      <span>Проектна</span>
      <strong>{{detail.item.display.projectedAvailableQty}}</strong>
      <small>наличност - резервирано + входящо</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric is-muted">
      <span>Минимум / цел</span>
      <strong>{{detail.item.display.minimumQty}} / {{detail.item.display.targetQty}}</strong>
      <small>planning thresholds</small>
    </article>
    <article class="ag-step-412__metric ag-step-4121__metric is-money">
      <span>Предложение</span>
      <strong>{{detail.item.display.recommendedOrderQty}}</strong>
      <small>{{detail.item.display.recommendedOrderValue}} ориентир стойност</small>
    </article>
  </section>

  <section class="ag-step-4122__detail-grid">
    <article class="module-card ag-step-412__card ag-step-4122__recommendation-card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Manager recommendation</p>
          <h2>Ръчна препоръка</h2>
        </div>
        <span class="ag-step-412__risk ag-step-412__risk--{{detail.item.riskLevel}}">{{detail.item.riskLabel}}</span>
      </div>
      <p>{{detail.manualRecommendation.explanation}}</p>
      <ul class="ag-step-4122__check-list">
        {{#each detail.manualRecommendation.suggestedManualSteps}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
      <div class="ag-step-4122__readonly-lock">
        <strong>Без автоматизация</strong>
        <span>Документ се създава само ръчно в съответния модул след човешко решение.</span>
      </div>
    </article>

    <article class="module-card ag-step-412__card ag-step-4122__signals-card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Planning signals</p>
          <h2>Причини и сигнали</h2>
        </div>
      </div>
      <div class="ag-step-4122__signals">
        {{#each detail.planningSignals}}
          <div class="ag-step-4122__signal tone-{{tone}}">
            <strong>{{title}}</strong>
            <span>{{value}}</span>
            <small>{{note}}</small>
          </div>
        {{/each}}
      </div>
    </article>
  </section>

  <section class="ag-step-4122__detail-grid">
    <article class="module-card ag-step-412__card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Warehouse drilldown</p>
          <h2>Наличност по обекти</h2>
        </div>
      </div>
      <div class="ag-step-412__table-wrap">
        <table class="ag-step-412__table ag-step-4122__compact-table">
          <thead>
            <tr>
              <th>Обект</th>
              <th class="num">Наличност</th>
              <th class="num">Резерв.</th>
              <th class="num">Входящо</th>
              <th class="num">Проектна</th>
              <th class="num">Мин.</th>
              <th class="num">Предл.</th>
              <th>Риск</th>
            </tr>
          </thead>
          <tbody>
            {{#each detail.warehouseRows}}
              <tr>
                <td>{{warehouseName}}</td>
                <td class="num">{{display.currentQty}}</td>
                <td class="num">{{display.reservedQty}}</td>
                <td class="num">{{display.inboundQty}}</td>
                <td class="num"><strong>{{display.projectedAvailableQty}}</strong></td>
                <td class="num">{{display.minimumQty}}</td>
                <td class="num">{{display.recommendedOrderQty}}</td>
                <td>{{riskLabel}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    </article>

    <article class="module-card ag-step-412__card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Movement context</p>
          <h2>Последни движения</h2>
        </div>
        <span class="ag-step-412__readonly-badge">read-only</span>
      </div>
      <ol class="ag-step-4122__timeline">
        {{#each detail.movementTimeline}}
          <li class="tone-{{tone}}">
            <strong>{{date}} · {{type}} · {{displayQty}}</strong>
            <span>{{documentNo}} · {{location}}</span>
            <small>{{note}}</small>
          </li>
        {{/each}}
      </ol>
    </article>
  </section>

  <section class="ag-step-4122__detail-grid">
    <article class="module-card ag-step-412__card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Item facts</p>
          <h2>Контекст за артикула</h2>
        </div>
      </div>
      <dl class="ag-step-4122__facts">
        <dt>Група</dt><dd>{{detail.item.groupName}}</dd>
        <dt>Доставчик</dt><dd>{{detail.item.supplierName}}</dd>
        <dt>Среден дневен разход</dt><dd>{{detail.item.display.averageDailyIssueQty}}</dd>
        <dt>Последна доставка</dt><dd>{{detail.item.display.lastPurchaseDate}}</dd>
        <dt>Последно изписване</dt><dd>{{detail.item.display.lastIssueDate}}</dd>
        <dt>Ед. цена</dt><dd>{{detail.item.display.unitCost}}</dd>
        <dt>Stock value</dt><dd>{{detail.item.display.stockValue}}</dd>
      </dl>
    </article>

    <article class="module-card ag-step-412__card">
      <div class="module-card-header">
        <div>
          <p class="module-kicker">Related planning</p>
          <h2>Свързани артикули от групата</h2>
        </div>
      </div>
      {{#if detail.relatedItems.length}}
        <ul class="ag-step-4121__mini-list ag-step-4122__related-list">
          {{#each detail.relatedItems}}
            <li>
              <a href="{{detailHref}}"><strong>{{itemCode}}</strong></a>
              <span>{{itemName}}</span>
              <small>{{riskLabel}} · {{priorityLabel}} · проектна {{displayProjectedQty}}</small>
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="ag-step-412__empty">Няма други артикули от същата група в текущия planning snapshot.</p>
      {{/if}}
    </article>
  </section>

  <footer class="ag-step-412__footer-note ag-step-4121__footer-note ag-step-4122__footer-note">
    <strong>Guardrails:</strong>
    {{#each detail.guardrails}}
      <span>{{this}}</span>
    {{/each}}
  </footer>
</section>
