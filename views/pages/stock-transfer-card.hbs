<div class="document-card-screen stock-transfer-card" data-document-card>
  <header class="document-card-header polished-document-header">
    <div>
      <div class="screen-kicker">Склад / Трансфер документ</div>
      <h1>Складов трансфер</h1>
      <p>{{transferCard.number}} · {{transferCard.transferDateText}} · {{transferCard.statusText}}</p>
    </div>

    <div class="document-card-actions">
      <a href="/stock/transfers">Назад</a>
      <a href="/stock/transfer/new">Нов</a>

      {{#if transferCard.canPost}}
        <form method="post" action="/stock/transfer/{{transferCard.id}}/status">
          <input type="hidden" name="status" value="POSTED" />
          <button type="submit">Публикувай</button>
        </form>
      {{/if}}

      {{#if transferCard.canCancel}}
        <form method="post" action="/stock/transfer/{{transferCard.id}}/status">
          <input type="hidden" name="status" value="CANCELLED" />
          <button type="submit">Отказ</button>
        </form>
      {{/if}}

      <button type="button">Печат</button>
    </div>
  </header>

  {{#if transferCard.actionMessage}}
    <section class="document-action-message success">
      <strong>Съобщение</strong>
      <span>{{transferCard.actionMessage}}</span>
    </section>
  {{/if}}

  {{#unless transferCard.isEditable}}
    <section class="document-lock-banner">
      <strong>Документът е заключен</strong>
      <span>{{transferCard.lockMessage}}</span>
    </section>
  {{/unless}}

  {{#if transferCard.hasInsufficientStock}}
    <section class="document-action-message warning">
      <strong>Внимание</strong>
      <span>Поне един ред няма достатъчна наличност в изходния склад.</span>
    </section>
  {{/if}}

  <section class="document-card-layout document-card-layout-polished">
    <main class="document-main-card document-main-card-polished">
      <section class="document-meta-grid transfer-route-grid">
        <label>
          <span>Номер</span>
          <input type="text" value="{{transferCard.number}}" readonly />
        </label>
        <label>
          <span>Дата</span>
          <input type="text" value="{{transferCard.transferDateText}}" readonly />
        </label>
        <label>
          <span>Статус</span>
          <input type="text" value="{{transferCard.statusText}}" readonly />
        </label>
        <label>
          <span>Общо количество</span>
          <input type="text" value="{{transferCard.summary.quantityText}}" readonly />
        </label>
      </section>

      <section class="document-counterparty-box stock-transfer-route-box">
        <div>
          <span>От склад</span>
          <strong>{{transferCard.fromWarehouse.name}}</strong>
          <em>{{transferCard.fromWarehouse.code}} · {{transferCard.fromWarehouse.typeText}} · {{transferCard.fromWarehouse.city}}</em>
        </div>
        <div>
          <span>Към склад</span>
          <strong>{{transferCard.toWarehouse.name}}</strong>
          <em>{{transferCard.toWarehouse.code}} · {{transferCard.toWarehouse.typeText}} · {{transferCard.toWarehouse.city}}</em>
        </div>
      </section>

      <section class="document-tabs real-document-tabs" role="tablist">
        <button class="active" type="button" data-card-tab="lines">Редове</button>
        <button type="button" data-card-tab="stock">Складови движения</button>
        <button type="button" data-card-tab="history">История</button>
        <button type="button" data-card-tab="notes">Бележки</button>
      </section>

      <section class="document-tab-panels">
        <article class="document-tab-panel active" data-card-panel="lines">
          {{#if transferCard.isEditable}}
            <form class="lines-toolbar real-line-form" method="post" action="/stock/transfer/{{transferCard.id}}/lines">
              <select name="itemId" required>
                <option value="">Избери артикул...</option>
                {{#each transferCard.availableItems}}
                  <option value="{{id}}">{{label}}</option>
                {{/each}}
              </select>
              <input name="quantity" type="number" step="0.001" min="0.001" value="1" />
              <input name="note" type="text" placeholder="Бележка към ред" />
              <button type="submit">Добави ред</button>
            </form>
          {{else}}
            <div class="locked-lines-toolbar">Редовете са само за преглед, защото трансферът е заключен.</div>
          {{/if}}

          <div class="document-lines-frame polished-lines-frame">
            <table class="document-lines-grid">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Код</th>
                  <th>Артикул</th>
                  <th>Мярка</th>
                  <th>Количество</th>
                  <th>Наличност от склад</th>
                  <th>Бележка</th>
                </tr>
              </thead>
              <tbody>
                {{#each transferCard.rows}}
                  <tr>
                    <td>{{index}}</td>
                    <td>{{itemCode}}</td>
                    <td>{{itemName}}</td>
                    <td>{{unit}}</td>
                    <td>{{quantityText}}</td>
                    <td>{{availableQuantityText}}</td>
                    <td>{{note}}</td>
                  </tr>
                {{else}}
                  <tr>
                    <td colspan="7">Няма редове в трансфера.</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>

          {{#if transferCard.isEditable}}
            <section class="line-edit-section">
              <h2>Редакция на редове</h2>
              {{#each transferCard.editableRows}}
                <div class="line-edit-row">
                  <div class="line-edit-title">
                    <strong>{{index}}. {{itemCode}}</strong>
                    <span>{{itemName}}</span>
                  </div>

                  <form method="post" action="/stock/transfer/{{../transferCard.id}}/lines/{{lineId}}/update">
                    <label>
                      <span>Количество</span>
                      <input name="quantity" type="number" step="0.001" min="0.001" value="{{rawQuantity}}" />
                    </label>
                    <label>
                      <span>Бележка</span>
                      <input name="note" type="text" value="{{note}}" />
                    </label>
                    <button type="submit">Запази</button>
                  </form>

                  <form method="post" action="/stock/transfer/{{../transferCard.id}}/lines/{{lineId}}/delete">
                    <button class="danger-button" type="submit">Изтрий</button>
                  </form>
                </div>
              {{else}}
                <p class="empty-note">Няма редове за редакция.</p>
              {{/each}}
            </section>
          {{/if}}
        </article>

        <article class="document-tab-panel" data-card-panel="stock">
          <div class="document-tab-inner">
            <h2>Складови движения</h2>
            {{#each transferCard.stockMovementRows}}
              <div class="stock-movement-row">
                <strong>{{number}}</strong>
                <span>{{movementDateText}}</span>
                <span>{{directionText}}</span>
                <span>{{warehouseName}}</span>
                <span>{{itemCode}} · {{itemName}}</span>
                <span>{{quantityText}}</span>
                <em>{{reason}}</em>
              </div>
            {{else}}
              <p class="empty-note">Движенията ще се създадат при публикуване на трансфера.</p>
            {{/each}}
          </div>
        </article>

        <article class="document-tab-panel" data-card-panel="history">
          <div class="document-tab-inner">
            <h2>История на трансфера</h2>
            {{#each transferCard.historyRows}}
              <div class="tab-list-row">
                <strong>{{time}}</strong>
                <span>{{user}}</span>
                <span>{{action}}</span>
                <em>{{details}}</em>
              </div>
            {{/each}}
          </div>
        </article>

        <article class="document-tab-panel" data-card-panel="notes">
          <div class="document-tab-inner notes-tab">
            <h2>Бележки</h2>
            <textarea readonly>{{transferCard.note}}</textarea>
            <div class="workflow-note">
              <strong>Работен поток</strong>
              <span>Чернова → Публикуван → заключен документ със складови OUT/IN движения.</span>
            </div>
          </div>
        </article>
      </section>
    </main>

    <aside class="document-side-card compact-document-side">
      <section class="document-total-box">
        <h2>Трансфер</h2>
        <div>
          <span>Редове</span>
          <strong>{{transferCard.summary.linesText}}</strong>
        </div>
        <div>
          <span>Количество</span>
          <strong>{{transferCard.summary.quantityText}}</strong>
        </div>
        <div class="grand-total">
          <span>Движения</span>
          <strong>{{transferCard.summary.movementRowsText}}</strong>
        </div>
      </section>

      <section class="document-info-box">
        <h2>От</h2>
        <div><span>Код</span><strong>{{transferCard.fromWarehouse.code}}</strong></div>
        <div><span>Склад</span><strong>{{transferCard.fromWarehouse.name}}</strong></div>
      </section>

      <section class="document-info-box">
        <h2>Към</h2>
        <div><span>Код</span><strong>{{transferCard.toWarehouse.code}}</strong></div>
        <div><span>Склад</span><strong>{{transferCard.toWarehouse.name}}</strong></div>
      </section>
    </aside>
  </section>
</div>
