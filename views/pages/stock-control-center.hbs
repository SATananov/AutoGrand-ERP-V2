<section class="stock-control-center stock-control-center-v491" data-module="stock-control-center" data-step="4.9.1">
  <header class="stock-control-center__hero">
    <div>
      <p class="stock-control-center__eyebrow">AutoGrand ERP · Step 4.9.1</p>
      <h1>{{pageTitle}}</h1>
      <p>{{pageSubtitle}}</p>
    </div>
    <div class="stock-control-center__hero-badge">
      <span>STATUS</span>
      <strong>CONTROL READY</strong>
      <small>Read-only consolidation layer</small>
    </div>
  </header>

  <section class="stock-control-center__metrics" aria-label="Stock control center metrics">
    {{#each metrics}}
      <article class="stock-control-center__metric stock-control-center__metric--{{tone}}">
        <span>{{bgLabel}}</span>
        <strong>{{value}}</strong>
        <small>{{label}} · {{state}}</small>
      </article>
    {{/each}}
  </section>

  <section class="stock-control-center__grid">
    <article class="stock-control-center__panel stock-control-center__panel--wide">
      <div class="stock-control-center__panel-head">
        <div>
          <p class="stock-control-center__eyebrow">Control lanes</p>
          <h2>Основни складови направления</h2>
        </div>
        <span class="stock-control-center__tag">Read-only</span>
      </div>

      <div class="stock-control-center__lanes">
        {{#each controlCards}}
          <section class="stock-control-center__lane {{#if isActive}}is-active{{/if}} {{#if isPlanned}}is-planned{{/if}}">
            <span class="stock-control-center__lane-number">{{number}}</span>
            <div>
              <h3>{{bgLabel}}</h3>
              <p>{{intent}}</p>
              <small>{{operatorNote}}</small>
            </div>
            <strong>{{status}}</strong>
          </section>
        {{/each}}
      </div>
    </article>

    <aside class="stock-control-center__panel">
      <div class="stock-control-center__panel-head">
        <div>
          <p class="stock-control-center__eyebrow">Operator checklist</p>
          <h2>Преди действие</h2>
        </div>
      </div>
      <ul class="stock-control-center__checklist">
        {{#each checklist}}
          <li>
            <strong>{{bgTitle}}</strong>
            <span>{{description}}</span>
          </li>
        {{/each}}
      </ul>
    </aside>
  </section>

  <section class="stock-control-center__grid stock-control-center__grid--bottom">
    <article class="stock-control-center__panel">
      <div class="stock-control-center__panel-head">
        <div>
          <p class="stock-control-center__eyebrow">QA gates</p>
          <h2>Контролни индикатори</h2>
        </div>
      </div>
      <div class="stock-control-center__qa-list">
        {{#each qaPanels}}
          <div class="stock-control-center__qa-item">
            <span>{{status}}</span>
            <div>
              <strong>{{bgTitle}}</strong>
              <small>{{detail}}</small>
            </div>
          </div>
        {{/each}}
      </div>
    </article>

    <article class="stock-control-center__panel">
      <div class="stock-control-center__panel-head">
        <div>
          <p class="stock-control-center__eyebrow">Safety rules</p>
          <h2>Moneta-safe правила</h2>
        </div>
      </div>
      <ul class="stock-control-center__rules">
        {{#each safetyRules}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    </article>

    <article class="stock-control-center__panel stock-control-center__panel--timeline">
      <div class="stock-control-center__panel-head">
        <div>
          <p class="stock-control-center__eyebrow">Checkpoint chain</p>
          <h2>Stock chain</h2>
        </div>
      </div>
      <div class="stock-control-center__timeline">
        {{#each stepSummary}}
          <div class="stock-control-center__timeline-row">
            <strong>{{step}}</strong>
            <div>
              <span>{{title}}</span>
              <small>{{note}}</small>
            </div>
          </div>
        {{/each}}
      </div>
    </article>
  </section>
</section>
