<section class="ag-stock-control-page ag-stock-control-page--v492">
  <header class="ag-stock-control-hero">
    <div>
      <p class="ag-stock-control-kicker">Складов контрол · Step 4.9.2</p>
      <h1>Stock Control Center</h1>
      <p>
        Консолидиран операторски център за трансфери, корекции, movement trace,
        audit safety и quick actions. Екранът е read-only и не променя stock journal.
      </p>
    </div>
    <div class="ag-stock-control-status-card">
      <span>Режим</span>
      <strong>{{summary.mode}}</strong>
      <small>{{summary.status.controlMode}} · {{summary.status.reversalSafety}}</small>
    </div>
  </header>

  <nav class="ag-stock-filter-strip" aria-label="Stock Control Center filters">
    {{#each filters}}
      <a class="ag-stock-filter-chip {{#if isActive}}is-active{{/if}}" href="/stock-control-center?filter={{key}}">
        <strong>{{label}}</strong>
        <span>{{description}}</span>
      </a>
    {{/each}}
  </nav>

  <section class="ag-stock-operator-dashboard">
    <article class="ag-stock-dashboard-card ag-stock-dashboard-card--primary">
      <span>Активен филтър</span>
      <strong>{{summary.activeFilter}}</strong>
      <small>{{summary.subtitle}}</small>
    </article>
    <article class="ag-stock-dashboard-card">
      <span>Risk panels</span>
      <strong>{{summary.counters.riskPanels}}</strong>
      <small>High/Critical: {{summary.counters.highRiskPanels}}</small>
    </article>
    <article class="ag-stock-dashboard-card">
      <span>Quick actions</span>
      <strong>{{summary.counters.quickActions}}</strong>
      <small>Само safe navigation</small>
    </article>
    <article class="ag-stock-dashboard-card">
      <span>Checkpoints</span>
      <strong>{{summary.counters.checkpoints}}</strong>
      <small>4.8 → 4.9.2</small>
    </article>
  </section>

  <section class="ag-stock-control-grid ag-stock-control-grid--v492">
    <div class="ag-stock-control-column">
      <div class="ag-stock-section-heading">
        <h2>Operational risk panels</h2>
        <p>Панели за риск и безопасно операторско решение.</p>
      </div>

      <div class="ag-stock-risk-panel-list">
        {{#each riskPanels}}
          <article class="ag-stock-risk-panel ag-stock-risk-panel--{{severity}}">
            <div class="ag-stock-risk-panel__head">
              <span>{{severity}}</span>
              <strong>{{label}}</strong>
            </div>
            <p>{{description}}</p>
            <div class="ag-stock-risk-panel__meta">
              <span>{{state}}</span>
              <b>{{metric}}</b>
            </div>
            <small>{{operatorHint}}</small>
          </article>
        {{/each}}
      </div>
    </div>

    <aside class="ag-stock-control-column ag-stock-control-column--side">
      <div class="ag-stock-section-heading">
        <h2>Quick actions</h2>
        <p>Бързи safe navigation действия.</p>
      </div>

      <div class="ag-stock-quick-action-list">
        {{#each quickActions}}
          <a class="ag-stock-quick-action" href="{{href}}">
            <strong>{{label}}</strong>
            <span>{{description}}</span>
          </a>
        {{/each}}
      </div>

      <div class="ag-stock-section-heading ag-stock-section-heading--compact">
        <h2>Operator checklist</h2>
      </div>
      <ol class="ag-stock-operator-checklist">
        {{#each operatorChecklist}}
          <li>
            <strong>{{label}}</strong>
            <span>{{description}}</span>
          </li>
        {{/each}}
      </ol>
    </aside>
  </section>

  <section class="ag-stock-checkpoint-timeline">
    <div class="ag-stock-section-heading">
      <h2>Stock checkpoint timeline</h2>
      <p>Затворената линия от correction до control center.</p>
    </div>
    <div class="ag-stock-timeline-row">
      {{#each checkpointTimeline}}
        <article class="ag-stock-timeline-item ag-stock-timeline-item--{{state}}">
          <span>{{step}}</span>
          <strong>{{label}}</strong>
          <small>{{state}}</small>
        </article>
      {{/each}}
    </div>
  </section>
</section>
<div class="ag-panel ag-stock-control-inspector-entry" data-ag-step="4.9.3-inspector-entry">
  <div>
    <p class="ag-eyebrow">Step 4.9.3</p>
    <h2>Detail Inspector</h2>
    <p class="ag-muted">Read-only drilldown to document, movement trace, reversal status, operator checklist and safe actions.</p>
  </div>
  <a class="ag-button ag-button--ghost" href="/stock-control-center/inspect?source=stock-control-center">Open inspector</a>
</div>
