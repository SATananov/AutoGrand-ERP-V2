generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  city      String?
  address   String?
  phone     String?
  createdAt DateTime @default(now())

  users     User[]
  employees Employee[]
  roles     Role[]
  locations CompanyLocation[]
}


model CompanyLocation {
  id                  Int      @id @default(autoincrement())
  code                String   @unique
  name                String
  type                String   @default("SHOP")
  city                String?
  address             String?
  phone               String?
  email               String?
  contactPerson       String?
  companyId           Int?
  canHoldStock        Boolean  @default(true)
  canSell             Boolean  @default(false)
  canReceivePurchases Boolean  @default(true)
  canTransfer         Boolean  @default(true)
  isDefault           Boolean  @default(false)
  isCurrent           Boolean  @default(false)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(100)
  createdAt           DateTime @default(now())

  company         Company?             @relation(fields: [companyId], references: [id])
  warehouses      Warehouse[]
  employeePrimaryFor Employee[]          @relation("EmployeePrimaryLocation")
  defaultForUsers User[]                @relation("UserDefaultLocation")
  userAccesses    UserLocationAccess[]

  @@index([type])
  @@index([city])
  @@index([companyId])
}

model Employee {
  id                Int      @id @default(autoincrement())
  code              String   @unique
  firstName         String?
  lastName          String?
  displayName       String
  position          String?
  phone             String?
  email             String?
  companyId         Int?
  primaryLocationId Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  company         Company?         @relation(fields: [companyId], references: [id])
  primaryLocation CompanyLocation? @relation("EmployeePrimaryLocation", fields: [primaryLocationId], references: [id])
  users           User[]

  @@index([companyId])
  @@index([primaryLocationId])
  @@index([isActive])
}

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  level       Int      @default(100)
  companyId   Int?
  isSystem    Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  company         Company?         @relation(fields: [companyId], references: [id])
  users           User[]
  rolePermissions RolePermission[]

  @@index([companyId])
  @@index([level])
  @@index([isActive])
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  module      String
  action      String
  name        String
  description String?
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([module])
  @@index([action])
  @@index([sortOrder])
}

model RolePermission {
  id           Int     @id @default(autoincrement())
  roleId       Int
  permissionId Int
  allowed      Boolean @default(true)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id                Int      @id @default(autoincrement())
  username          String   @unique
  displayName       String
  role              String   @default("operator")
  passwordHash      String?
  language          String   @default("bg")
  companyId         Int?
  employeeId        Int?
  roleId            Int?
  defaultLocationId Int?
  isActive          Boolean  @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime @default(now())

  company             Company?                 @relation(fields: [companyId], references: [id])
  employee            Employee?                @relation(fields: [employeeId], references: [id])
  roleTemplate        Role?                    @relation(fields: [roleId], references: [id])
  defaultLocation     CompanyLocation?         @relation("UserDefaultLocation", fields: [defaultLocationId], references: [id])
  locationAccesses    UserLocationAccess[]
  permissionOverrides UserPermissionOverride[]

  @@index([companyId])
  @@index([employeeId])
  @@index([roleId])
  @@index([defaultLocationId])
  @@index([isActive])
}

model UserLocationAccess {
  id                  Int      @id @default(autoincrement())
  userId              Int
  locationId          Int
  isDefault           Boolean  @default(false)
  canLogin            Boolean  @default(true)
  canSell             Boolean  @default(false)
  canRequestTransfer  Boolean  @default(false)
  canDispatchTransfer Boolean  @default(false)
  canReceiveTransfer  Boolean  @default(false)
  createdAt           DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  location CompanyLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([locationId])
}

model UserPermissionOverride {
  id           Int      @id @default(autoincrement())
  userId       Int
  permissionId Int
  allowed      Boolean  @default(true)
  reason       String?
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId])
}

model Counterparty {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  kind      String   @default("CUSTOMER")
  bulstat   String?
  vatNumber String?
  city      String?
  address   String?
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  salesDocuments    SalesDocument[]
  purchaseDocuments PurchaseDocument[]
  serviceOrders     ServiceOrder[]
}

model Item {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  groupName      String?
  unit           String   @default("бр.")
  barcode        String?
  retailPrice    Float    @default(0)
  wholesalePrice Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  priceListItems PriceListItem[]
  salesLines     SalesDocumentLine[]
  purchaseLines  PurchaseDocumentLine[]
  stockBalances      StockBalance[]
  stockMovements     StockMovement[]
  stockTransferLines  StockTransferLine[]
  stockAdjustmentLines StockAdjustmentLine[]
  serviceLines        ServiceOrderLine[]
}

model Warehouse {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  name       String
  city       String?
  locationId Int?     @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  location CompanyLocation? @relation(fields: [locationId], references: [id])
  salesDocuments    SalesDocument[]
  salesLines        SalesDocumentLine[]
  purchaseDocuments PurchaseDocument[]
  purchaseLines     PurchaseDocumentLine[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  transferFromDocs  StockTransferDocument[] @relation("StockTransferFromWarehouse")
  transferToDocs    StockTransferDocument[] @relation("StockTransferToWarehouse")
  adjustmentDocs    StockAdjustmentDocument[]
}

model PriceList {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  currency  String   @default("BGN")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  items PriceListItem[]
}

model PriceListItem {
  id          Int    @id @default(autoincrement())
  priceListId Int
  itemId      Int
  price       Float
  vatPercent  Float  @default(20)
  note        String?

  priceList PriceList @relation(fields: [priceListId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])

  @@unique([priceListId, itemId])
}

model SalesDocument {
  id             Int      @id @default(autoincrement())
  number         String   @unique
  docType        String
  docDate        DateTime @default(now())
  counterpartyId Int?
  warehouseId    Int?
  status         String   @default("DRAFT")
  totalNet       Float    @default(0)
  totalVat       Float    @default(0)
  totalGross     Float    @default(0)
  note           String?
  createdAt      DateTime @default(now())

  counterparty Counterparty?       @relation(fields: [counterpartyId], references: [id])
  warehouse    Warehouse?          @relation(fields: [warehouseId], references: [id])
  lines        SalesDocumentLine[]
}

model SalesDocumentLine {
  id              Int   @id @default(autoincrement())
  documentId      Int
  itemId          Int?
  warehouseId     Int?
  quantity        Float @default(1)
  price           Float @default(0)
  discountPercent Float @default(0)
  lineTotal       Float @default(0)

  document  SalesDocument @relation(fields: [documentId], references: [id])
  item      Item?         @relation(fields: [itemId], references: [id])
  warehouse Warehouse?    @relation(fields: [warehouseId], references: [id])
}

model PurchaseDocument {
  id          Int      @id @default(autoincrement())
  number      String   @unique
  docType     String
  docDate     DateTime @default(now())
  supplierId  Int?
  warehouseId Int?
  status      String   @default("DRAFT")
  totalNet    Float    @default(0)
  totalVat    Float    @default(0)
  totalGross  Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())

  supplier  Counterparty?          @relation(fields: [supplierId], references: [id])
  warehouse Warehouse?             @relation(fields: [warehouseId], references: [id])
  lines     PurchaseDocumentLine[]
}

model PurchaseDocumentLine {
  id          Int   @id @default(autoincrement())
  documentId  Int
  itemId      Int?
  warehouseId Int?
  quantity    Float @default(1)
  price       Float @default(0)
  lineTotal   Float @default(0)

  document  PurchaseDocument @relation(fields: [documentId], references: [id])
  item      Item?            @relation(fields: [itemId], references: [id])
  warehouse Warehouse?       @relation(fields: [warehouseId], references: [id])
}

model StockBalance {
  id               Int      @id @default(autoincrement())
  warehouseId       Int
  itemId            Int
  quantity          Float    @default(0)
  reservedQuantity  Float    @default(0)
  avgCost           Float    @default(0)
  updatedAt         DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])

  @@unique([warehouseId, itemId])
}

model StockMovement {
  id             Int      @id @default(autoincrement())
  number         String   @unique
  movementType   String
  movementDate   DateTime @default(now())
  warehouseId    Int?
  itemId         Int?
  quantity       Float    @default(0)
  direction      String
  reason         String?
  sourceDocument String?
  note           String?
  createdAt      DateTime @default(now())

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id])
  item      Item?      @relation(fields: [itemId], references: [id])
}


model StockTransferDocument {
  id              Int      @id @default(autoincrement())
  number          String   @unique
  transferDate    DateTime @default(now())
  fromWarehouseId Int
  toWarehouseId   Int
  status          String   @default("DRAFT")
  note            String?
  createdAt       DateTime @default(now())
  postedAt        DateTime?
  cancelledAt     DateTime?

  fromWarehouse Warehouse           @relation("StockTransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("StockTransferToWarehouse", fields: [toWarehouseId], references: [id])
  lines         StockTransferLine[]

  @@index([status])
  @@index([transferDate])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model StockTransferLine {
  id         Int    @id @default(autoincrement())
  documentId Int
  itemId     Int?
  quantity   Float  @default(1)
  note       String?

  document StockTransferDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  item     Item?                 @relation(fields: [itemId], references: [id])

  @@index([documentId])
  @@index([itemId])
}


model StockAdjustmentDocument {
  id             Int      @id @default(autoincrement())
  number         String   @unique
  adjustmentDate DateTime @default(now())
  warehouseId    Int
  adjustmentType String   @default("CORRECTION_IN")
  status         String   @default("DRAFT")
  note           String?
  createdAt      DateTime @default(now())
  postedAt       DateTime?
  cancelledAt    DateTime?

  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  lines     StockAdjustmentLine[]

  @@index([status])
  @@index([adjustmentDate])
  @@index([warehouseId])
  @@index([adjustmentType])
}

model StockAdjustmentLine {
  id         Int    @id @default(autoincrement())
  documentId Int
  itemId     Int?
  quantity   Float  @default(1)
  direction  String @default("IN")
  reason     String?
  note       String?

  document StockAdjustmentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  item     Item?                   @relation(fields: [itemId], references: [id])

  @@index([documentId])
  @@index([itemId])
  @@index([direction])
}

model CashEntry {
  id               Int      @id @default(autoincrement())
  number           String   @unique
  entryDate        DateTime @default(now())
  kind             String
  description      String
  counterpartyName String?
  amount           Float    @default(0)
  currency         String   @default("BGN")
  paymentMethod    String   @default("cash")
  relatedDocument  String?
  createdAt        DateTime @default(now())
}

model Vehicle {
  id           Int      @id @default(autoincrement())
  registration String   @unique
  vin          String?
  brand        String
  model        String
  year         Int?
  ownerName    String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())

  serviceOrders ServiceOrder[]
}

model ServiceOrder {
  id                 Int      @id @default(autoincrement())
  number             String   @unique
  orderDate          DateTime @default(now())
  vehicleId          Int?
  counterpartyId     Int?
  status             String   @default("OPEN")
  problemDescription String?
  totalGross         Float    @default(0)
  createdAt          DateTime @default(now())

  vehicle      Vehicle?           @relation(fields: [vehicleId], references: [id])
  counterparty Counterparty?      @relation(fields: [counterpartyId], references: [id])
  lines        ServiceOrderLine[]
}

model ServiceOrderLine {
  id             Int    @id @default(autoincrement())
  serviceOrderId Int
  itemId         Int?
  description    String
  quantity       Float  @default(1)
  price          Float  @default(0)
  lineTotal      Float  @default(0)

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id])
  item         Item?        @relation(fields: [itemId], references: [id])
}