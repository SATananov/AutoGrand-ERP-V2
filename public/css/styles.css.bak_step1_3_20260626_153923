* {
  box-sizing: border-box;
}

:root {
  --ag-bg: #dfead8;
  --ag-bg-2: #edf4e9;
  --ag-panel: #f8fbf5;
  --ag-panel-2: #eef6e8;
  --ag-line: #b9cdb1;
  --ag-line-dark: #8ea57f;
  --ag-green: #1f4d33;
  --ag-green-2: #2f6845;
  --ag-green-3: #547d3f;
  --ag-light: #cfe6b8;
  --ag-active: #b8d99d;
  --ag-yellow: #f0a000;
  --ag-text: #202820;
  --ag-muted: #5f6e5d;
  --ag-white: #ffffff;
  --ag-shadow: rgba(53, 76, 48, 0.18);
}

html,
body {
  margin: 0;
  min-height: 100%;
  overflow: hidden;
  font-family: "Segoe UI", Arial, Helvetica, sans-serif;
  color: var(--ag-text);
  background: var(--ag-bg);
}

button,
input,
select,
textarea {
  font-family: inherit;
}

.erp-desktop-shell {
  height: 100vh;
  display: grid;
  grid-template-rows: 58px 105px 1fr 30px;
  background: linear-gradient(180deg, #edf6e8 0, #dce9d5 100%);
}

.erp-titlebar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  height: 58px;
  padding: 0 8px 0 16px;
  border-bottom: 1px solid #c8d7be;
  background: linear-gradient(180deg, #f7fbf4, #e6efe0);
}

.brand-zone {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
}

.brand-road {
  width: 56px;
  height: 38px;
  object-fit: contain;
}

.brand-company {
  font-size: 21px;
  line-height: 1;
  font-weight: 900;
  color: #566057;
  white-space: nowrap;
}

.brand-version {
  color: #a2aaa1;
  font-size: 16px;
  font-weight: 700;
}

.titlebar-user {
  display: flex;
  align-items: center;
  gap: 13px;
  color: #5a6258;
  font-size: 16px;
  font-weight: 800;
}

.top-icon {
  position: relative;
  display: inline-grid;
  place-items: center;
  min-width: 24px;
  height: 24px;
  font-size: 20px;
}

.top-icon.badge em {
  position: absolute;
  top: -8px;
  right: -8px;
  min-width: 20px;
  height: 20px;
  padding: 0 5px;
  border-radius: 999px;
  background: #e60019;
  color: white;
  font-style: normal;
  font-size: 13px;
  line-height: 20px;
  text-align: center;
}

.logout-button {
  min-width: 116px;
  height: 38px;
  border: 1px solid #74ad20;
  border-radius: 4px;
  color: white;
  background: linear-gradient(180deg, #83d321, #55a80d);
  font-weight: 900;
  font-size: 19px;
  cursor: pointer;
}

.erp-ribbon {
  display: flex;
  align-items: stretch;
  height: 105px;
  overflow-x: auto;
  overflow-y: hidden;
  border-bottom: 1px solid #b7c6ab;
  background: linear-gradient(180deg, #ecf5e5, #dbe7d1);
}

.ribbon-group {
  display: flex;
  align-items: stretch;
  border-right: 1px solid #b8c6ad;
}

.ribbon-button {
  width: 88px;
  border: 0;
  border-left: 1px solid rgba(255, 255, 255, 0.65);
  border-right: 1px solid rgba(150, 165, 140, 0.25);
  background: transparent;
  color: #59635a;
  cursor: pointer;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 5px;
}

.ribbon-button:hover {
  background: rgba(184, 217, 157, 0.6);
}

.ribbon-icon {
  font-size: 31px;
  line-height: 1;
}

.ribbon-label {
  font-size: 15px;
  line-height: 1.15;
}

.erp-main {
  min-height: 0;
  display: grid;
  grid-template-columns: 505px 1fr;
}

.erp-menu {
  min-width: 0;
  min-height: 0;
  display: grid;
  grid-template-rows: 41px 1fr;
  border-right: 1px solid var(--ag-line-dark);
  background: #eef4ea;
}

.menu-title {
  display: flex;
  align-items: center;
  gap: 10px;
  height: 41px;
  padding: 0 8px;
  background: linear-gradient(180deg, #214e35, #123723);
  color: white;
  font-size: 25px;
  font-weight: 900;
}

.menu-title span:first-child {
  flex: 1;
}

.pin,
.collapse {
  min-width: 42px;
  height: 40px;
  display: grid;
  place-items: center;
  border-left: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.08);
}

.menu-scroll {
  overflow: auto;
  padding: 0 0 14px 0;
  background: #f5f8f2;
}

.tree-group {
  border-bottom: 1px solid #d5dfcd;
}

.tree-group summary {
  list-style: none;
  display: flex;
  align-items: center;
  gap: 9px;
  height: 39px;
  padding: 0 10px;
  cursor: pointer;
  color: #111c12;
  background: #edf3e9;
  font-size: 20px;
  font-weight: 800;
}

.tree-group summary::-webkit-details-marker {
  display: none;
}

.tree-group[open] summary {
  background: #cfe8bb;
  border-left: 6px solid #6ea238;
}

.tree-icon {
  width: 22px;
  text-align: center;
}

.tree-items {
  padding: 4px 0 6px 38px;
  background: white;
}

.tree-item,
.tree-folder {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 31px;
  padding: 2px 8px 2px 0;
  color: #111;
  text-decoration: none;
  font-size: 20px;
  line-height: 1.15;
  white-space: nowrap;
}

.tree-item:hover {
  background: #eef6e7;
}

.tree-item.active {
  outline: 2px solid #8fc36a;
  background: #dff0d3;
  font-weight: 900;
}

.doc-icon {
  color: #0e0e0e;
  width: 20px;
  text-align: center;
}

.tree-folder {
  color: #122214;
  font-weight: 800;
}

.erp-workspace {
  min-width: 0;
  min-height: 0;
  display: grid;
  grid-template-rows: 49px 1fr;
  background: linear-gradient(180deg, #e8f2e1, #dcead4);
}

.tab-strip {
  display: flex;
  align-items: end;
  padding-left: 14px;
  gap: 4px;
  border-bottom: 1px solid #bfceb5;
  background: linear-gradient(180deg, #edf5e8, #dce9d5);
}

.workspace-tab {
  display: inline-flex;
  align-items: center;
  height: 39px;
  padding: 0 15px;
  background: white;
  border: 1px solid #bdcfb4;
  border-bottom: 0;
  color: #111;
  font-size: 17px;
  font-weight: 900;
  text-decoration: none;
}

.workspace-window {
  min-width: 0;
  min-height: 0;
  overflow: auto;
  padding: 24px 28px;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.35), transparent 28%),
    linear-gradient(180deg, #e7f2e0, #d9e8d0);
}

.home-screen {
  display: grid;
  gap: 22px;
}

.home-hero,
.step-panel,
.reference-screen,
.not-found-screen {
  padding: 24px;
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid #bfd2b5;
  border-radius: 12px;
  box-shadow: 0 12px 28px var(--ag-shadow);
}

.home-hero h1,
.generated-screen h1,
.reference-screen h1,
.not-found-screen h1 {
  margin: 0 0 10px;
  font-size: 33px;
  color: #2d3430;
}

.home-hero p,
.reference-screen p,
.not-found-screen p {
  margin: 0;
  color: #657063;
  font-size: 18px;
  line-height: 1.45;
}

.dashboard-cards,
.step-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(190px, 1fr));
  gap: 18px;
}

.dashboard-card,
.step-grid article,
.reference-box {
  padding: 20px;
  background: rgba(255, 255, 255, 0.86);
  border: 1px solid #c3d5ba;
  border-radius: 12px;
  box-shadow: 0 10px 22px var(--ag-shadow);
}

.dashboard-card strong {
  display: block;
  color: #314132;
  font-size: 34px;
}

.dashboard-card span {
  display: block;
  color: #1d2b1e;
  font-size: 20px;
  font-weight: 900;
}

.dashboard-card small {
  color: #657063;
  font-size: 15px;
}

.step-panel h2 {
  margin: 0 0 14px;
  font-size: 26px;
}

.step-grid h3 {
  margin: 0 0 10px;
  font-size: 21px;
}

.step-grid p {
  margin: 0;
  color: #657063;
  font-size: 17px;
  line-height: 1.35;
}

.generated-screen {
  min-height: 100%;
  display: grid;
  grid-template-rows: auto auto 1fr;
  gap: 12px;
}

.screen-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 18px;
}

.screen-header p {
  margin: 0;
  color: #657063;
  font-size: 16px;
}

.screen-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.screen-actions button {
  height: 32px;
  padding: 0 12px;
  border: 1px solid #95ac8c;
  border-radius: 4px;
  background: linear-gradient(180deg, #ffffff, #e7f0df);
  color: #2d372c;
  font-weight: 700;
}

.browse-frame {
  min-height: 0;
  overflow: auto;
  border: 1px solid #9fb391;
  background: white;
  box-shadow: inset 0 1px 0 white;
}

.browse-grid {
  width: 100%;
  border-collapse: collapse;
  font-size: 15px;
}

.browse-grid th {
  position: sticky;
  top: 0;
  z-index: 1;
  height: 36px;
  padding: 7px 10px;
  border-right: 1px solid #bac9b0;
  border-bottom: 1px solid #93a487;
  background: linear-gradient(180deg, #d9e8cf, #c3d8b6);
  color: #1f2a1e;
  text-align: left;
  white-space: nowrap;
}

.browse-grid td {
  height: 34px;
  padding: 6px 10px;
  border-right: 1px solid #d7e0d0;
  border-bottom: 1px solid #e0e7dc;
  color: #1e251e;
  white-space: nowrap;
}

.browse-grid tbody tr:nth-child(even) td {
  background: #f6faf4;
}

.browse-grid tbody tr:hover td {
  background: #e1f0d6;
}

.row-number {
  width: 46px;
  text-align: right !important;
  color: #62705f !important;
}

.db-warning {
  display: grid;
  gap: 4px;
  margin-top: 14px;
  padding: 12px 14px;
  border: 1px solid #c8a64a;
  border-radius: 8px;
  background: #fff8df;
  color: #4f4118;
}

.db-warning strong {
  color: #3d310f;
}

.erp-statusbar {
  display: grid;
  grid-template-columns: 1.7fr 1fr 1fr 1.35fr 1fr 1fr 110px;
  align-items: center;
  height: 30px;
  border-top: 1px solid #bac9b0;
  background: linear-gradient(180deg, #f4f8f0, #e1ebda);
  color: #5c6859;
  font-size: 15px;
}

.erp-statusbar div {
  height: 100%;
  display: flex;
  align-items: center;
  padding: 0 10px;
  border-right: 1px solid #c7d3be;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.erp-statusbar div:nth-child(3) {
  font-weight: 900;
  color: #2d3b2d;
}

@media (max-width: 1100px) {
  .erp-main {
    grid-template-columns: 360px 1fr;
  }

  .brand-company {
    font-size: 16px;
  }

  .titlebar-user strong {
    display: none;
  }

  .dashboard-cards,
  .step-grid {
    grid-template-columns: repeat(2, minmax(170px, 1fr));
  }
}

/* Step 1.1 — Moneta Sales Screens Applied */
.sales-screen {
  min-height: 100%;
  display: grid;
  grid-template-rows: auto auto 1fr;
  gap: 12px;
}

.sales-screen-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 18px;
  padding: 12px 14px;
  border: 1px solid #b8cdb0;
  background: linear-gradient(180deg, rgba(255,255,255,0.86), rgba(240,248,235,0.9));
  box-shadow: 0 8px 18px rgba(53, 76, 48, 0.12);
}

.screen-title-block h1 {
  margin: 0;
  color: #253126;
  font-size: 30px;
  line-height: 1.05;
}

.screen-title-block p {
  margin: 6px 0 0;
  color: #667060;
  font-size: 15px;
}

.screen-kicker {
  margin-bottom: 4px;
  color: #4d7b35;
  font-size: 13px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.screen-command-strip {
  display: flex;
  flex-wrap: wrap;
  justify-content: end;
  gap: 6px;
}

.screen-command-strip button,
.moneta-filter-bar button,
.preview-actions button {
  min-height: 30px;
  padding: 0 11px;
  border: 1px solid #8faa80;
  border-radius: 3px;
  background: linear-gradient(180deg, #ffffff, #e4efdd);
  color: #2d382b;
  font-weight: 800;
  cursor: pointer;
}

.screen-command-strip button:hover,
.moneta-filter-bar button:hover,
.preview-actions button:hover {
  background: linear-gradient(180deg, #f8fff3, #d1e8c2);
}

.moneta-filter-bar {
  display: grid;
  grid-template-columns: 210px 170px 1fr 140px;
  gap: 8px;
  align-items: end;
  padding: 10px 12px;
  border: 1px solid #adc49f;
  background: linear-gradient(180deg, #eef7e8, #dbead3);
}

.moneta-filter-bar label {
  display: grid;
  gap: 3px;
}

.moneta-filter-bar span {
  color: #4f5d4e;
  font-size: 12px;
  font-weight: 900;
}

.moneta-filter-bar select,
.moneta-filter-bar input {
  height: 31px;
  width: 100%;
  border: 1px solid #96ac8d;
  border-radius: 2px;
  padding: 0 8px;
  background: white;
  color: #1f2b1e;
  font-size: 14px;
}

.sales-workbench {
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(580px, 1fr) 360px;
  gap: 12px;
}

.sales-grid-panel,
.sales-detail-panel {
  min-width: 0;
  min-height: 0;
  display: grid;
  grid-template-rows: 34px 1fr 28px;
  border: 1px solid #9fb391;
  background: #f9fcf7;
  box-shadow: 0 10px 20px rgba(53, 76, 48, 0.12);
}

.sales-detail-panel {
  grid-template-rows: 34px 1fr;
}

.panel-caption {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  padding: 0 10px;
  border-bottom: 1px solid #a9bb9d;
  background: linear-gradient(180deg, #d9eacb, #c5dbb6);
  color: #243024;
}

.panel-caption strong {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.panel-caption span {
  color: #59695a;
  font-size: 13px;
  font-weight: 800;
}

.sales-browse-frame {
  min-height: 0;
  border: 0;
  box-shadow: none;
}

.sales-grid .selectable-row {
  cursor: default;
}

.sales-grid .selectable-row.active td {
  background: #cfe8bb !important;
  color: #102010;
  font-weight: 800;
}

.sales-grid .selectable-row[hidden] {
  display: none;
}

.grid-status-line {
  display: flex;
  align-items: center;
  gap: 18px;
  min-width: 0;
  padding: 0 10px;
  border-top: 1px solid #c5d3bb;
  background: #eef5e9;
  color: #5e6d5e;
  font-size: 13px;
  font-weight: 700;
}

.detail-preview-stack {
  position: relative;
  min-height: 0;
  overflow: auto;
  padding: 10px;
  background: linear-gradient(180deg, #f7fbf4, #edf6e8);
}

.detail-preview {
  display: none;
  border: 1px solid #b4c7a9;
  background: white;
  box-shadow: 0 8px 16px rgba(53, 76, 48, 0.10);
}

.detail-preview.active {
  display: block;
}

.preview-head {
  display: grid;
  gap: 3px;
  padding: 12px;
  border-bottom: 1px solid #d5e1ce;
  background: linear-gradient(180deg, #f7fbf4, #e3f0da);
}

.preview-head span {
  color: #5f7557;
  font-size: 12px;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.preview-head strong {
  color: #243024;
  font-size: 19px;
}

.preview-fields {
  display: grid;
  gap: 1px;
  padding: 8px;
}

.preview-field {
  display: grid;
  grid-template-columns: 130px 1fr;
  gap: 8px;
  align-items: center;
  min-height: 31px;
  padding: 5px 7px;
  border-bottom: 1px solid #edf2e9;
}

.preview-field span {
  color: #667060;
  font-size: 13px;
  font-weight: 800;
}

.preview-field strong {
  color: #202820;
  font-size: 14px;
  word-break: break-word;
}

.preview-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  padding: 10px;
  border-top: 1px solid #d5e1ce;
  background: #f4f9f0;
}

@media (max-width: 1250px) {
  .sales-workbench {
    grid-template-columns: 1fr;
  }

  .sales-detail-panel {
    min-height: 320px;
  }

  .moneta-filter-bar {
    grid-template-columns: 1fr 1fr;
  }
}

/* Step 1.2 — Sales Document Card Foundation */
.preview-open-link {
  min-height: 30px;
  padding: 6px 11px;
  border: 1px solid #8faa80;
  border-radius: 3px;
  background: linear-gradient(180deg, #ffffff, #e4efdd);
  color: #2d382b;
  font-weight: 800;
  text-decoration: none;
  cursor: pointer;
}

.preview-open-link:hover {
  background: linear-gradient(180deg, #f8fff3, #d1e8c2);
}

.document-card-screen {
  min-height: 100%;
  display: grid;
  grid-template-rows: auto 1fr;
  gap: 12px;
}

.document-card-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 18px;
  padding: 12px 14px;
  border: 1px solid #b8cdb0;
  background: linear-gradient(180deg, rgba(255,255,255,0.88), rgba(240,248,235,0.94));
  box-shadow: 0 8px 18px rgba(53, 76, 48, 0.12);
}

.document-card-header h1 {
  margin: 0;
  color: #253126;
  font-size: 30px;
  line-height: 1.05;
}

.document-card-header p {
  margin: 6px 0 0;
  color: #667060;
  font-size: 15px;
}

.document-card-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: end;
  gap: 6px;
}

.document-card-actions button,
.document-card-actions a {
  min-height: 30px;
  padding: 6px 11px;
  border: 1px solid #8faa80;
  border-radius: 3px;
  background: linear-gradient(180deg, #ffffff, #e4efdd);
  color: #2d382b;
  font-weight: 800;
  text-decoration: none;
  cursor: pointer;
}

.document-card-layout {
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(720px, 1fr) 340px;
  gap: 12px;
}

.document-main-card,
.document-side-card {
  min-width: 0;
  min-height: 0;
  border: 1px solid #9fb391;
  background: rgba(255,255,255,0.92);
  box-shadow: 0 10px 20px rgba(53, 76, 48, 0.12);
}

.document-main-card {
  display: grid;
  grid-template-rows: auto auto auto 1fr auto;
  overflow: hidden;
}

.document-meta-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(180px, 1fr));
  gap: 8px;
  padding: 12px;
  border-bottom: 1px solid #c9d8c0;
  background: linear-gradient(180deg, #f7fbf4, #edf6e8);
}

.document-meta-grid label {
  display: grid;
  gap: 3px;
}

.document-meta-grid span,
.document-counterparty-box span,
.document-note span,
.document-total-box span,
.document-info-box span {
  color: #5f6d5d;
  font-size: 12px;
  font-weight: 900;
}

.document-meta-grid input {
  height: 31px;
  border: 1px solid #9fb391;
  border-radius: 2px;
  padding: 0 8px;
  background: white;
  color: #1f2b1e;
  font-size: 14px;
  font-weight: 800;
}

.document-counterparty-box {
  display: grid;
  grid-template-columns: 2fr 0.8fr 1fr 1fr;
  gap: 1px;
  border-bottom: 1px solid #c9d8c0;
  background: #d5e3cd;
}

.document-counterparty-box div {
  display: grid;
  gap: 4px;
  padding: 10px 12px;
  background: #ffffff;
}

.document-counterparty-box strong {
  color: #1f2b1e;
  font-size: 15px;
}

.document-tabs {
  display: flex;
  align-items: end;
  gap: 3px;
  min-height: 40px;
  padding: 0 10px;
  border-bottom: 1px solid #a8bb9d;
  background: linear-gradient(180deg, #edf6e8, #dcebd3);
}

.document-tabs button {
  height: 31px;
  padding: 0 13px;
  border: 1px solid #a8bb9d;
  border-bottom: 0;
  background: #eef6e8;
  color: #314131;
  font-weight: 900;
  cursor: pointer;
}

.document-tabs button.active {
  background: white;
}

.document-lines-frame {
  min-height: 0;
  overflow: auto;
  background: white;
}

.document-lines-grid {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}

.document-lines-grid th {
  position: sticky;
  top: 0;
  z-index: 1;
  height: 34px;
  padding: 7px 9px;
  border-right: 1px solid #bac9b0;
  border-bottom: 1px solid #93a487;
  background: linear-gradient(180deg, #d9e8cf, #c3d8b6);
  color: #1f2a1e;
  text-align: left;
  white-space: nowrap;
}

.document-lines-grid td {
  height: 32px;
  padding: 6px 9px;
  border-right: 1px solid #d7e0d0;
  border-bottom: 1px solid #e0e7dc;
  white-space: nowrap;
}

.document-lines-grid tbody tr:nth-child(even) td {
  background: #f6faf4;
}

.document-lines-grid tbody tr:hover td {
  background: #e1f0d6;
}

.document-note {
  display: grid;
  gap: 4px;
  padding: 10px 12px;
  border-top: 1px solid #c9d8c0;
  background: #f7fbf4;
}

.document-note p {
  margin: 0;
  color: #2b342b;
  font-size: 14px;
}

.document-side-card {
  display: grid;
  align-content: start;
  gap: 10px;
  padding: 10px;
  overflow: auto;
  background: linear-gradient(180deg, #f7fbf4, #edf6e8);
}

.document-total-box,
.document-info-box {
  border: 1px solid #b8cdb0;
  background: white;
}

.document-total-box h2,
.document-info-box h2 {
  margin: 0;
  padding: 9px 10px;
  border-bottom: 1px solid #c9d8c0;
  background: linear-gradient(180deg, #d9e8cf, #c3d8b6);
  color: #263326;
  font-size: 18px;
}

.document-total-box div,
.document-info-box div {
  display: flex;
  justify-content: space-between;
  gap: 10px;
  padding: 9px 10px;
  border-bottom: 1px solid #edf2e9;
}

.document-total-box strong,
.document-info-box strong {
  color: #1f2b1e;
}

.document-total-box .grand-total {
  background: #d9edcb;
}

.document-total-box .grand-total strong {
  font-size: 20px;
}

.payment-row {
  display: grid !important;
  justify-content: stretch !important;
  gap: 4px !important;
}

.payment-row span {
  font-size: 13px !important;
  font-weight: 700 !important;
}

.empty-note {
  margin: 0;
  padding: 10px;
  color: #667060;
  font-size: 14px;
}

@media (max-width: 1300px) {
  .document-card-layout {
    grid-template-columns: 1fr;
  }

  .document-meta-grid {
    grid-template-columns: repeat(2, minmax(180px, 1fr));
  }

  .document-counterparty-box {
    grid-template-columns: 1fr 1fr;
  }
}