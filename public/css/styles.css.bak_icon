*{box-sizing:border-box}:root{--bg:#0f1711;--panel:#193421;--line:rgba(214,245,206,.18);--text:#eef7eb;--muted:#b8cdb4;--accent:#b7e071;--accent2:#d8f7a2;--shadow:rgba(0,0,0,.32)}body{margin:0;min-height:100vh;background:radial-gradient(circle at top left,#2b5534 0,#101a12 42%,#071009 100%);color:var(--text);font-family:Arial,Helvetica,sans-serif}a{color:inherit}.app-shell{display:grid;grid-template-columns:280px 1fr;min-height:100vh}.sidebar{background:linear-gradient(180deg,#17351f,#102316);border-right:1px solid var(--line);padding:24px;position:sticky;top:0;height:100vh}.brand-card{display:flex;gap:14px;align-items:center;padding:16px;background:rgba(255,255,255,.06);border:1px solid var(--line);border-radius:18px;box-shadow:0 16px 32px var(--shadow)}.brand-mark{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,#c6ed7a,#72a84f);color:#0d1b10;font-weight:900}.brand-title{font-size:18px;font-weight:800}.brand-subtitle{color:var(--muted);font-size:13px;margin-top:3px}.main-nav{display:grid;gap:10px;margin:24px 0}.nav-link{text-decoration:none;padding:13px 14px;border-radius:14px;background:rgba(255,255,255,.04);border:1px solid transparent;color:var(--muted)}.nav-link:hover{color:var(--text);border-color:var(--line);background:rgba(183,224,113,.08)}.nav-link.active{color:#0d1b10;background:var(--accent);font-weight:900}.sidebar-note{display:grid;gap:8px;padding:15px;border:1px solid var(--line);border-radius:16px;color:var(--muted);background:rgba(0,0,0,.18)}.sidebar-note strong{color:var(--accent2)}.workspace{padding:28px;display:grid;align-content:start;gap:22px}.hero-window,.content-window{border:1px solid var(--line);border-radius:22px;background:linear-gradient(180deg,rgba(31,70,43,.94),rgba(20,42,27,.96));box-shadow:0 18px 40px var(--shadow)}.hero-window{display:grid;grid-template-columns:1fr 360px;gap:24px;padding:34px}.eyebrow{color:var(--accent);text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:800}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(32px,5vw,58px);line-height:1;margin-bottom:18px}.hero-text{color:var(--muted);font-size:18px;line-height:1.55;max-width:850px}.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}.primary-button,.ghost-button{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:11px 18px;border-radius:999px;text-decoration:none;font-weight:800}.primary-button{background:var(--accent);color:#0d1b10}.ghost-button{border:1px solid var(--line);color:var(--text)}.stat-board{display:grid;gap:14px}.stat-box{padding:20px;border-radius:18px;background:rgba(0,0,0,.2);border:1px solid var(--line)}.stat-box span{display:block;font-size:34px;font-weight:900;color:var(--accent2)}.stat-box small{color:var(--muted)}.content-window{padding:24px}.window-titlebar{display:flex;justify-content:space-between;gap:18px;align-items:center;padding-bottom:18px;margin-bottom:20px;border-bottom:1px solid var(--line)}.window-titlebar h1,.window-titlebar h2{margin:0}.window-titlebar span{color:var(--accent);font-size:13px;text-transform:uppercase;letter-spacing:.08em}.module-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px}.module-card{text-decoration:none;display:grid;gap:10px;padding:18px;border-radius:18px;border:1px solid var(--line);background:rgba(255,255,255,.045);min-height:190px}.module-card:hover{background:rgba(183,224,113,.08);transform:translateY(-1px)}.module-code,.module-path,code{font-family:Consolas,Monaco,monospace}.module-code{color:var(--accent);font-size:12px}.module-card h3{margin:0;font-size:22px}.module-card p{color:var(--muted);line-height:1.45}.module-path{margin-top:auto;color:var(--accent2);font-size:12px}.summary-grid,.log-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}.summary-card,.log-grid>div,.reference-note,.next-box{padding:16px;border:1px solid var(--line);border-radius:16px;background:rgba(0,0,0,.16)}.summary-card strong,.log-grid strong{display:block;font-size:26px;color:var(--accent2)}.summary-card span,.log-grid span,.muted{color:var(--muted)}.reference-note{margin-top:18px;line-height:1.5}.erp-table{width:100%;border-collapse:collapse;overflow:hidden;border-radius:16px}.erp-table th,.erp-table td{padding:13px 14px;border-bottom:1px solid var(--line);text-align:left}.erp-table th{color:var(--accent2);font-size:13px;text-transform:uppercase;letter-spacing:.06em}.erp-table td{color:var(--muted)}.erp-table a{color:var(--text);font-weight:800;text-decoration:none}.detail-layout{display:grid;grid-template-columns:1fr 320px;gap:24px}.module-purpose{font-size:18px;color:var(--muted);line-height:1.55}pre{padding:16px;border-radius:16px;background:rgba(0,0,0,.24);overflow:auto}.status-pill{display:inline-flex;padding:8px 12px;border-radius:999px;background:rgba(183,224,113,.15);color:var(--accent2);border:1px solid var(--line)}.next-box ul{margin:0;padding-left:18px;color:var(--muted);line-height:1.7}@media(max-width:900px){.app-shell{grid-template-columns:1fr}.sidebar{position:static;height:auto}.hero-window{grid-template-columns:1fr}.detail-layout{grid-template-columns:1fr}}
